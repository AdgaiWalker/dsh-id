{
  "name": "dsh-id",
  "version": "0.2.0",
  "description": "DSH bundle：给 AI Agent 的账号执行层——凭据按需注入、登录态复用、不可逆操作闸门、哈希链审计。工具不返回凭据值。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node test/offline.mjs && node test/exec.mjs",
    "test:readonly": "node test/offline.mjs",
    "test:exec": "node test/exec.mjs",
    "prepare:test-deps": "node scripts/link-test-deps.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdgaiWalker/dsh-id.git"
  },
  "homepage": "https://github.com/AdgaiWalker/dsh-id",
  "bugs": {
    "url": "https://github.com/AdgaiWalker/dsh-id/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "credentials",
    "secrets",
    "agent",
    "security"
  ]
}
