#!/usr/bin/env python3
"""vault-proxy — 本地凭据代理【已停用，勿再 enable】

⚠ 当前状态：systemd 用户服务已 stop + disable，48771 不监听。
   不要再 `systemctl --user enable --now vault-proxy.service`。

为什么停用
----------
本服务常驻 127.0.0.1:48771 且**无调用者认证**：同一用户下任何进程
（包括 AI 的 shell）只要知道凭据名，就能用真实凭据发请求。凭据名可以从
`vault-cred list` 或 proxy/ 目录名枚举。

给代理"加认证"解决不了根本问题：同用户下密钥文件可读，AI/shell 一样能
拿到。共享 header、Unix socket 都不构成对同用户进程的安全边界。

替代方案
--------
改用按需注入：`vault-exec run` / `vault-exec curl`
（见 ~/.local/bin/vault-exec，凭据只在子进程存活期间存在，命令结束即失效，
不驻留、不监听端口）。

URL 契约
--------
    http://127.0.0.1:48771/<凭据名>/<上游域名>/<路径>

示例
----
    curl http://127.0.0.1:48771/github-pat/api.github.com/user
    # 代理内部变成 https://api.github.com/user + Authorization: Bearer <值>

处理顺序（安全关键）
--------------------
    1. 解析 URL → 凭据名 + host + path
    2. 读**明文元数据**判断凭据是否存在        → 404 unknown_credential
    3. **在解密之前**校验 host 白名单          → 403 host_not_allowed
    4. 此时才解密凭据值，按类型注入
    5. 用真实 HTTPS 转发上游，原样回传响应    → 502 upstream_error
    6. 每次请求写审计（只记元信息）

参考实现：agent-id plugins/agent-id-proxy/lib/rewrite.mjs（URL 契约 + 注入）、
          agent-id plugins/agent-id-vault/lib/access.mjs（白名单）
"""

import base64
import http.client
import json
import os
import socket
import ssl
import sys
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

sys.path.insert(0, os.path.expanduser("~/.local/lib"))
import vaultlib as V  # noqa: E402

HOST = "127.0.0.1"          # 只监听本机，绝不 0.0.0.0
PORT = 48771
TIMEOUT = 30

# 不转发给上游的请求头（含代理自己的 header、会泄露本地地址的、hop-by-hop）
STRIP_REQ_HEADERS = {
    "host", "origin", "referer", "connection", "keep-alive", "proxy-authenticate",
    "proxy-authorization", "te", "trailers", "transfer-encoding", "upgrade",
    "content-length", "accept-encoding",
}
STRIP_RESP_HEADERS = {
    "connection", "keep-alive", "proxy-authenticate", "proxy-authorization",
    "te", "trailers", "transfer-encoding", "upgrade", "content-length",
    "content-encoding",
}


def parse_rewrite_path(raw_path):
    """把 /<cred>/<host>/<rest>?<query> 拆成 (cred, host, path_with_query)。

    解析规则移植自 agent-id rewrite.mjs parseRewritePath：
    host 段可以带 :port；path 从第三个 / 开始，查询串原样保留。
    """
    if not raw_path.startswith("/"):
        return None
    body = raw_path[1:]
    if not body:
        return None

    slash = body.find("/")
    if slash <= 0:
        return None
    cred = body[:slash]
    rest = body[slash + 1:]
    if not rest:
        return None

    # host 段：到下一个 / 或 ? 为止
    nxt = len(rest)
    for ch in ("/", "?"):
        i = rest.find(ch)
        if i != -1 and i < nxt:
            nxt = i
    host = rest[:nxt]
    tail = rest[nxt:]
    if not host:
        return None
    if not tail.startswith("/"):
        tail = "/" + tail.lstrip("?")
    return cred, host.lower(), tail


def build_upstream_headers(client_headers, cred_meta, secret):
    """按凭据类型把值注入到请求头 / 查询参数。返回 (headers, extra_query)。"""
    headers = {}
    for k, v in client_headers.items():
        if k.lower() in STRIP_REQ_HEADERS:
            continue
        headers[k] = v

    extra_query = None
    ctype = cred_meta["type"]

    if ctype == "bearer":
        headers["Authorization"] = "Bearer " + secret
    elif ctype == "basic":
        # basic 的值存成 "user:pass"
        token = base64.b64encode(secret.encode()).decode()
        headers["Authorization"] = "Basic " + token
    elif ctype == "header":
        hname = cred_meta.get("header_name") or "X-Api-Key"
        headers[hname] = secret
    elif ctype == "query":
        pname = cred_meta.get("param_name") or "api_key"
        extra_query = (pname, secret)
    else:
        raise V.VaultError("unknown_credential", "不支持的凭据类型: " + str(ctype))

    return headers, extra_query


def forward(host, path_with_query, method, headers, body):
    """用真实 HTTPS 转发。返回 (status, resp_headers, resp_body)。"""
    # host 可能带端口
    if ":" in host:
        h, _, p = host.partition(":")
        try:
            port = int(p)
        except ValueError:
            raise V.VaultError("upstream_error", "端口非法")
    else:
        h, port = host, 443

    ctx = ssl.create_default_context()
    conn = http.client.HTTPSConnection(h, port, timeout=TIMEOUT, context=ctx)
    try:
        conn.request(method, path_with_query, body=body, headers=headers)
        resp = conn.getresponse()
        data = resp.read()
        return resp.status, dict(resp.getheaders()), data
    except socket.timeout:
        raise V.VaultError("upstream_error", "上游超时")
    except ssl.SSLError as e:
        raise V.VaultError("upstream_error", "TLS 失败: " + str(e))
    except (OSError, http.client.HTTPException) as e:
        raise V.VaultError("upstream_error", "上游连接失败: " + str(e))
    finally:
        try:
            conn.close()
        except Exception:
            pass


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "vault-proxy/1.0"

    def log_message(self, fmt, *args):
        # 关掉默认的 access log（它会带完整 URL）；审计走 audit.log
        pass

    # ── 错误应答 ──
    def _fail(self, status, code, cred, host, path, detail=""):
        payload = {"error": code}
        if detail:
            payload["detail"] = detail
        body = json.dumps(payload).encode()
        try:
            V.audit(cred, host, path, status, note=code)
        except Exception:
            pass
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("X-Vault-Proxy-Error", code)
        self.end_headers()
        self.wfile.write(body)

    def _handle(self, method):
        raw = self.path
        cred = host = path = None
        try:
            parsed = parse_rewrite_path(raw)
            if parsed is None:
                # 契约不匹配：无法确定凭据，按未知凭据处理
                self._fail(404, "unknown_credential", None, None, raw,
                           "URL 应为 /<凭据名>/<上游域名>/<路径>")
                return
            cred, host, path = parsed

            if not V.CREDNAME_RE.match(cred):
                self._fail(404, "unknown_credential", cred, host, path, "凭据名非法")
                return

            # ① 只读明文元数据 → 存在性
            try:
                meta = V.load_meta(cred)
            except V.VaultError as e:
                self._fail(404 if e.code == "unknown_credential" else 401,
                           e.code, cred, host, path)
                return

            # ② 解密之前校验白名单（安全红线 3）
            # host 可能带 :port（如 api.github.com:8443），白名单只比对主机名部分
            hostname = host.rsplit(":", 1)[0] if ":" in host else host
            domains = meta.get("domains") or []
            if not V.host_matches_allowlist(hostname, domains):
                self._fail(403, "host_not_allowed", cred, host, path,
                           "host 不在该凭据的 domains 白名单内")
                return

            # ③ 到这里才解密
            try:
                secret = V.load_secret(cred)
            except V.VaultError as e:
                self._fail(401, "vault_locked", cred, host, path)
                return

            # ④ 注入
            try:
                headers, extra_query = build_upstream_headers(
                    self.headers, meta, secret)
            except V.VaultError as e:
                self._fail(401, e.code, cred, host, path)
                return
            finally:
                secret = None  # 尽早丢弃引用

            if extra_query:
                sep = "&" if "?" in path else "?"
                path = path + sep + urllib.parse.urlencode(
                    {extra_query[0]: extra_query[1]})

            # ⑤ 转发
            length = int(self.headers.get("Content-Length") or 0)
            body = self.rfile.read(length) if length else None
            try:
                status, resp_headers, data = forward(
                    host, path, method, headers, body)
            except V.VaultError as e:
                self._fail(502, "upstream_error", cred, host, path, str(e))
                return

            # ⑥ 审计 + 回传
            try:
                V.audit(cred, host, path, status)
            except Exception:
                pass

            self.send_response(status)
            for k, v in resp_headers.items():
                if k.lower() in STRIP_RESP_HEADERS:
                    continue
                self.send_header(k, v)
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        except BrokenPipeError:
            pass
        except Exception as e:  # 兜底：绝不因异常把凭据值带进日志
            self._fail(502, "upstream_error", cred, host, path, type(e).__name__)

    def do_GET(self):
        self._handle("GET")

    def do_POST(self):
        self._handle("POST")

    def do_PUT(self):
        self._handle("PUT")

    def do_PATCH(self):
        self._handle("PATCH")

    def do_DELETE(self):
        self._handle("DELETE")

    def do_HEAD(self):
        self._handle("HEAD")


def main():
    # 注意：这里**不能**无条件 ensure_key()。
    # 启用主密码后重建明文 key 会生成一把新 key，与所有旧密文不匹配，
    # 等于把保险库锁死（真实事故）。ensure_key 内部已加了防护。
    if not V.master_enabled():
        V.ensure_key()
    os.makedirs(V.PROXY_DIR, mode=0o700, exist_ok=True)
    srv = ThreadingHTTPServer((HOST, PORT), Handler)
    srv.daemon_threads = True
    print(f"vault-proxy listening on http://{HOST}:{PORT}", flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        srv.server_close()


if __name__ == "__main__":
    main()
