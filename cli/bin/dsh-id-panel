#!/usr/bin/env python3
"""dsh-id panel — 本机账号与凭据面板（只绑 127.0.0.1）。

看：凭据名/类型/白名单、网页会话/有效期、审计链状态。
改：新增凭据、改白名单、删凭据、删会话、生成待吊销清单。

绝不返回凭据值：明文只在 POST 进来的一瞬间交给 vault-cred（走 stdin），
不落盘、不回显、不进日志。
"""
import argparse
import json
import os
import subprocess
import sys
import urllib.parse
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

sys.path.insert(0, os.path.expanduser("~/.local/lib"))
import vaultlib as V  # noqa: E402

BIN = os.path.expanduser("~/.local/bin")
TYPES = ("bearer", "basic", "header", "query", "totp", "card")
TOKEN = "dsh-id-panel"          # 自定义请求头，挡住浏览器跨站简单请求
PAGE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "panel.html")


def _run(cmd, *args, stdin_data=None):
    try:
        r = subprocess.run([os.path.join(BIN, cmd), *args], input=stdin_data,
                           capture_output=True, text=True, timeout=60)
        return r.returncode, (r.stdout or "") + (r.stderr or "")
    except Exception as exc:
        return 99, f"{exc}"


def _norm_domains(v):
    if isinstance(v, str):
        v = v.strip().strip("[]").replace("'", "").replace('"', "")
        return [x.strip() for x in v.split(",") if x.strip()]
    return [str(x) for x in (v or [])]


def state():
    creds, factors, unscoped = [], [], []
    for m in V.list_credentials():
        lstate, left = V.lease_state(m)
        sc = V.scope_of(m)
        item = {
            "name": m.get("name", "?"),
            "type": m.get("type", "?"),
            "domains": _norm_domains(m.get("domains")),
            "created": m.get("created_at", ""),
            "lease": m.get("lease_days", 0),
            "lease_state": lstate,
            "days_left": left,
            "methods": sc["methods"],
            "paths": sc["paths"],
            "legacy": bool(m.get("legacy_file")),
            "card": V.card_summary(m) if m.get("type") == "card" else None,
        }
        creds.append(item)
        if item["type"] == "totp":
            lu = V.last_used(item["name"], actions=("login", "totp")) or {}
            factors.append({"name": item["name"], "type": item["type"],
                            "site": (item["domains"] or ["-"])[0],
                            "last": lu.get("ts") or "",
                            "legacy": item["legacy"]})
        elif not sc["methods"] and not sc["paths"]:
            unscoped.append(item["name"])
    profiles = {p.get("name") for p in V.list_login_profiles()}
    sessions = []
    for s in V.list_sessions():
        exp = int(s.get("expires_at") or 0)
        sessions.append({
            "name": s.get("name", "?"),
            "domain": s.get("domain", "?"),
            "saved": s.get("saved_at_str", ""),
            "expires": s.get("expires_at_str", ""),
            "cookies": s.get("cookies", ""),
            "days_left": max(0, -((int(__import__("time").time()) - exp) // 86400)) if exp else None,
            "expired": V.session_expired(s),
            "profile": s.get("name") in profiles,
        })
    ok, problems, total, legacy = V.verify_chain()
    if ok is None:
        audit = {"state": "unknown", "detail": problems[0][1] if problems else "", "rows": total}
    elif ok:
        audit = {"state": "ok", "rows": total, "legacy": legacy}
    else:
        audit = {"state": "broken", "rows": total,
                 "detail": "; ".join(f"第{n}行 {m}" for n, m in problems[:3])}
    pending = 0
    try:
        with open(os.path.join(V._vault_dir(), "guard-pending.json"), encoding="utf-8") as fh:
            pending = len((json.load(fh) or {}).get("pending", []))
    except Exception:
        pending = 0
    qdirs = [d["stamp"] for d in V.list_quarantines()]
    recent = V.recent_logs(20)
    legacy_pending = [x for x in V.legacy_files() if not V.meta_exists(x["name"])]
    anchor_path = os.path.join(V._vault_dir(), "audit-anchor.json")
    if not os.path.exists(anchor_path):
        anchor_path = os.path.expanduser("~/.dsh/log/dsh-id-audit-anchor.json")
    anchor = {"exists": os.path.exists(anchor_path)}
    if anchor["exists"]:
        try:
            with open(anchor_path, encoding="utf-8") as fh:
                rec = json.load(fh)
            status, detail = V.verify_anchor(anchor_path)
            anchor.update({"rows": rec.get("rows"), "ts": rec.get("ts_str"),
                           "status": status, "detail": detail})
        except Exception as exc:
            anchor.update({"status": "unknown", "detail": str(exc)[:120]})
    return {"creds": creds, "factors": factors, "sessions": sessions, "audit": audit,
            "pending": pending, "quarantines": qdirs, "logs": recent,
            "unscoped": unscoped, "legacy_pending": len(legacy_pending),
            "anchor": anchor,
            "version": V.VERSION, "repo": "AdgaiWalker/dsh-id",
            "vault": V._vault_dir(), "types": list(TYPES)}


def action(op, body, ctx=None):
    """返回 (ok, 说明)。所有写操作走现有 CLI，不重写加密逻辑。"""
    if op == "cred_add":
        name = str(body.get("name", "")).strip()
        ctype = str(body.get("type", "")).strip()
        secret = str(body.get("secret", ""))
        domains = ",".join(_norm_domains(body.get("domains")))
        if not name or ctype not in TYPES:
            return False, "名字和类型要填"
        if ctype not in V.NO_EXEC_TYPES and (not secret or not domains):
            return False, "HTTP 类凭据：白名单和值都要填"
        if ctype == "totp" and not secret:
            return False, "TOTP 要填 base32 种子"
        args = ["add", name, ctype, "--domains", domains]
        if ctype == "header":
            hn = str(body.get("header_name", "")).strip()
            if not hn:
                return False, "header 类型要填请求头名"
            args += ["--header-name", hn]
        if ctype == "query":
            pn = str(body.get("param_name", "")).strip()
            if not pn:
                return False, "query 类型要填参数名"
            args += ["--param-name", pn]
        if ctype == "card":
            number = str(body.get("card_number", "")).strip()
            cvv = str(body.get("cvv", "")).strip()
            if not number or not cvv:
                return False, "卡号与 CVV 都要填"
            args += ["--holder", str(body.get("holder", "")).strip(),
                     "--expiry", str(body.get("expiry", "")).strip(),
                     "--billing", str(body.get("billing", "")).strip()]
            rc, out = _run("vault-cred", *args, stdin_data=number + "\n" + cvv + "\n")
        elif ctype == "totp":
            rc, out = _run("vault-cred", *args, stdin_data=secret + "\n")
        else:
            rc, out = _run("vault-cred", *args, stdin_data=secret + "\n")
        if rc != 0:
            return False, out.strip().splitlines()[-1] if out.strip() else "新增失败"
        V.audit_event(action="panel_cred_add", cred=name, host=domains.split(",")[0],
                      path="-", status=0, note="via dsh-id panel")
        return True, f"已新增 {name}"

    if op == "cred_lease":
        name = str(body.get("name", "")).strip()
        days = int(body.get("days", 90))
        rc, out = _run("vault-cred", "lease", name, "--days", str(days), "--reset")
        if rc != 0:
            return False, (out.strip().splitlines()[-1] if out.strip() else "设置失败")
        return True, out.strip().splitlines()[-1]

    if op == "cred_rotate":
        name = str(body.get("name", "")).strip()
        secret = str(body.get("secret", ""))
        if not name or not secret:
            return False, "名字和新值都要填"
        rc, out = _run("vault-cred", "rotate", name, stdin_data=secret + "\n")
        if rc != 0:
            return False, (out.strip().splitlines()[-1] if out.strip() else "轮换失败")
        return True, f"已轮换 {name}"

    if op == "cred_rm":
        name = str(body.get("name", "")).strip()
        if not name:
            return False, "缺名字"
        V.remove_credential(name)
        V.audit_event(action="panel_cred_rm", cred=name, host="-", path="-",
                      status=0, note="via dsh-id panel")
        return True, f"已删除 {name}"

    if op == "cred_domains":
        name = str(body.get("name", "")).strip()
        domains = _norm_domains(body.get("domains"))
        if not name or not domains:
            return False, "缺名字或白名单"
        path = os.path.join(V.proxy_dir(), f"{name}.meta.json")
        if not os.path.exists(path):
            return False, "凭据不存在"
        with open(path, encoding="utf-8") as fh:
            meta = json.load(fh)
        meta["domains"] = domains
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(meta, fh, ensure_ascii=False)
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
        V.audit_event(action="panel_cred_domains", cred=name, host=domains[0],
                      path="-", status=0, note="via dsh-id panel")
        return True, f"{name} 白名单已改为 {', '.join(domains)}"

    if op == "session_rm":
        name = str(body.get("name", "")).strip()
        if not name:
            return False, "缺名字"
        V.remove_session(name)
        V.audit_event(action="panel_session_rm", cred=name, host="-", path="-",
                      status=0, note="session removed via dsh-id panel")
        return True, f"已删除会话 {name}"

    if op == "session_check":
        name = str(body.get("name", "")).strip()
        rc, out = _run("vault-session", "check", name)
        tail = " ".join(out.strip().splitlines()[-2:])[:200]
        return rc == 0, (tail or "已检查")

    if op == "cred_adopt":
        rc, out = _run("vault-cred", "adopt")
        if rc != 0:
            return False, (out.strip().splitlines()[-1] if out.strip() else "归档失败")
        return True, "已把老格式密文登记进索引（密文未改动）"

    if op == "cred_totp":
        name = str(body.get("name", "")).strip()
        try:
            meta = V.load_meta(name)
        except V.VaultError:
            return False, "凭据不存在"
        if meta.get("type") not in V.NO_EXEC_TYPES or meta.get("type") != "totp":
            return False, "这不是 TOTP 种子"
        seed = V.load_secret(name)
        code = V.totp_code(seed)
        seed = None
        V.audit_event(action="panel_totp", cred=name, host="127.0.0.1", path="-",
                      status=200, note="code_issued_local")
        return True, {"name": name, "code": code, "left": V.totp_lifetime(), "period": 30}

    if op == "cred_scope":
        name = str(body.get("name", "")).strip()
        if not name:
            return False, "缺名字"
        methods = _norm_domains(body.get("methods"))
        paths = _norm_domains(body.get("paths"))
        args = ["scope", name, "--methods", ",".join(methods), "--paths", ",".join(paths)]
        rc, out = _run("vault-cred", *args)
        if rc != 0:
            return False, (out.strip().splitlines()[-1] if out.strip() else "设置失败")
        return True, out.strip().splitlines()[0]

    if op == "audit_anchor":
        rc, out = _run("vault-cred", "audit-anchor")
        if rc != 0:
            return False, (out.strip().splitlines()[-1] if out.strip() else "导出失败")
        return True, out.strip().splitlines()[0]

    if op == "revoke_list":
        p = os.path.join(V._vault_dir(), "REVOKE.md")
        rc, out = _run("vault-cred", "revoke-list", "--out", p)
        return rc == 0, (out.strip().splitlines()[0] if out.strip() else p)

    if op == "check_update":
        try:
            req = urllib.request.Request(
                "https://api.github.com/repos/AdgaiWalker/dsh-id/releases/latest",
                headers={"User-Agent": "dsh-id", "Accept": "application/vnd.github+json"})
            with urllib.request.urlopen(req, timeout=6) as r:
                latest = json.load(r).get("tag_name", "").lstrip("v")
        except urllib.error.HTTPError as exc:
            if exc.code in (403, 429):
                cache = os.path.join(V._vault_dir(), "release-cache.json")
                if os.path.exists(cache):
                    try:
                        with open(cache, encoding="utf-8") as fh:
                            c = json.load(fh)
                        return True, f"GitHub 限流（HTTP {exc.code}）；用上次结果：上游 {c.get('latest')}，当前 {V.VERSION}"
                    except Exception:
                        pass
                return False, f"GitHub 限流（HTTP {exc.code}），过一会儿再试"
            if exc.code == 404:
                return True, f"仓库还没发过 release（当前 {V.VERSION}）"
            return False, f"检查失败: HTTP {exc.code}"
        except Exception as exc:
            return False, f"检查失败（离线？）: {exc}"
        def _v(x):
            try:
                return tuple(int(p) for p in str(x).lstrip("v").split(".")[:3])
            except Exception:
                return (0,)
        try:
            with open(os.path.join(V._vault_dir(), "release-cache.json"), "w") as fh:
                json.dump({"latest": latest, "at": int(__import__("time").time())}, fh)
        except Exception:
            pass
        if not latest:
            return False, "Release 里没读到版本号"
        if _v(latest) > _v(V.VERSION):
            return True, f"有新版本 {latest}（当前 {V.VERSION}）"
        return True, f"已是最新（当前 {V.VERSION}，上游 {latest}）"

    if op == "audit_verify":
        ok, problems, total, legacy = V.verify_chain()
        if ok is None:
            return False, problems[0][1] if problems else "无法校验"
        if ok:
            return True, f"哈希链完整（{total} 行，旧格式 {legacy} 行）"
        return False, f"发现 {len(problems)} 处问题，第一处：第{problems[0][0]}行 {problems[0][1]}"

    return False, f"不认识的操作 {op}"


class Handler(BaseHTTPRequestHandler):
    server_version = "dsh-id-panel"

    def log_message(self, fmt, *args):   # 不记录请求体，避免任何值进日志
        sys.stderr.write("%s %s\n" % (self.log_date_time_string(), fmt % args))

    def _send(self, code, body, ctype="application/json; charset=utf-8"):
        raw = body.encode("utf-8") if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(raw)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Referrer-Policy", "no-referrer")
        self.end_headers()
        self.wfile.write(raw)

    def _local_only(self):
        """出码只给本机直连。

        经 testsite/cloudflared 反代时 Host 会被改写成 127.0.0.1:<port>，
        所以不能只信 Host：公网请求一定带 CF-Connecting-IP 或 X-Forwarded-For。
        三个条件全满足才放行：Host 是回环、两个代理头都不存在。
        """
        host = (self.headers.get("Host") or "").rsplit(":", 1)[0].strip().lower()
        if host not in ("127.0.0.1", "localhost", "::1"):
            return False, "host=" + (host or "-")
        if self.headers.get("CF-Connecting-IP"):
            return False, "cf-connecting-ip"
        if self.headers.get("X-Forwarded-For"):
            return False, "x-forwarded-for"
        return True, ""

    def _origin_ok(self):
        """同源即可：经隧道/反代访问时 Origin 是 https://<公网 host>，Host 也是它。
        跨站（含恶意页面）Origin 的 host 与 Host 不同 → 拒绝。"""
        origin = self.headers.get("Origin")
        if not origin:
            return True
        try:
            p = urllib.parse.urlparse(origin)
        except Exception:
            return False
        oh = (p.netloc or "").lower()
        host = (self.headers.get("Host") or "").lower()
        if oh and oh == host:
            return True
        return oh in (f"127.0.0.1:{self.server.server_port}",
                      f"localhost:{self.server.server_port}")

    def do_GET(self):
        path = urllib.parse.urlparse(self.path).path
        if path == "/":
            try:
                with open(PAGE, encoding="utf-8") as fh:
                    return self._send(200, fh.read(), "text/html; charset=utf-8")
            except OSError:
                return self._send(500, "panel.html missing", "text/plain; charset=utf-8")
        if path == "/api/state":
            if not self._origin_ok():
                return self._send(403, json.dumps({"error": "origin"}))
            return self._send(200, json.dumps(state(), ensure_ascii=False))
        return self._send(404, json.dumps({"error": "not found"}))

    def do_POST(self):
        path = urllib.parse.urlparse(self.path).path
        if path != "/api/action":
            return self._send(404, json.dumps({"error": "not found"}))
        # 三大门槛：自定义头 + Origin 校验 + JSON Content-Type
        if self.headers.get("X-DSH-ID") != TOKEN or not self._origin_ok():
            return self._send(403, json.dumps({"error": "forbidden"}, ensure_ascii=False))
        if "application/json" not in (self.headers.get("Content-Type") or ""):
            return self._send(415, json.dumps({"error": "json only"}, ensure_ascii=False))
        try:
            n = int(self.headers.get("Content-Length") or 0)
            body = json.loads(self.rfile.read(n) or b"{}")
        except Exception:
            return self._send(400, json.dumps({"error": "bad json"}, ensure_ascii=False))
        op = str(body.pop("op", ""))
        ctx = {"host": self.headers.get("Host") or ""}
        if op == "cred_totp":
            allowed, why = self._local_only()
            if not allowed:
                try:
                    V.audit_event(action="panel_totp_denied",
                                  cred=str(body.get("name") or "-"),
                                  host=ctx["host"] or "-", path="-", status=403,
                                  note="denied=" + why)
                except Exception:
                    pass
                return self._send(403, json.dumps(
                    {"ok": False, "message": "TOTP 出码只允许本机直连（公网入口拒绝）"},
                    ensure_ascii=False))
        try:
            ok, msg = action(op, body, ctx)
        except Exception as exc:
            ok, msg = False, f"服务端错误: {exc}"
        try:
            V.app_log("panel_" + op, ok=ok, msg=msg[:120])
        except Exception:
            pass
        return self._send(200 if ok else 400,
                          json.dumps({"ok": ok, "message": msg}, ensure_ascii=False))


def main():
    ap = argparse.ArgumentParser(prog="dsh-id panel")
    ap.add_argument("--port", type=int, default=8791)
    a = ap.parse_args()
    srv = ThreadingHTTPServer(("127.0.0.1", a.port), Handler)
    print(f"dsh-id panel → http://127.0.0.1:{a.port}  (仅本机)")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
