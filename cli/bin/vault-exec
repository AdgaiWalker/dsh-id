#!/usr/bin/env python3
"""vault-exec — 按需注入凭据，命令结束即失效（替代常驻凭据代理）

为什么不再用常驻代理
--------------------
原 vault-proxy 常驻 127.0.0.1:48771 且无调用者认证：同机任何进程只要知道凭据名，
就能用真实凭据发请求。给代理"加认证"解决不了根本问题——同用户下密钥文件可读，
AI/shell 一样能拿到。所以取消常驻监听，改成"要用时才解密、用完即失效"。

两种模式
--------
    vault-exec run <凭据名> -- <命令...>
        解密凭据，注入子进程环境变量，执行命令，透传 stdout/stderr/退出码。
        环境变量：
            VAULT_SECRET      凭据明文（仅在子进程环境里，不进 argv）
            VAULT_CRED_TYPE   bearer | basic | header | query
            VAULT_CRED_NAME   凭据名
            以及 meta 里配置的 env 名（如 env_name: GITHUB_TOKEN）

    vault-exec curl <凭据名> <url> [--log-request] [--allow-http-error] [curl 参数...]
        解密凭据，注入到 curl 的 header/query，发一次请求。
        host 必须在凭据 domains 白名单内，否则拒绝。
        --log-request       额外在 net.log 记请求明细（脱敏 URL、方法、状态码、
                            耗时、响应大小）。不记凭据值、请求头、响应体。
        --allow-http-error  HTTP >=400 时仍返回 0（老行为）。默认会返回 22，
                            便于调用方用退出码区分成败；正文照样输出。

安全约定
--------
- 凭据值**绝不进 argv**（argv 会出现在 ps），只走环境变量或 0600 临时文件
- 凭据值**绝不打印**到 stdout/stderr/日志
- 审计只记：凭据名、命令名、退出码、host —— 绝不记值
- 解密失败 / 凭据不存在 → 明确错误码（见下）

退出码
------
    0    成功
    2    用法错误
    3    凭据不存在
    4    host 不在白名单
    5    解密失败（vault 锁定/密钥不对）
    6    凭据类型不支持
    8    凭据租约到期（先 vault-cred rotate <名字>）
    22   HTTP >= 400（curl --fail-with-body 的约定），正文仍会输出
    其余 透传被包装命令的退出码

示例
----
    vault-exec run github-pat -- env | grep VAULT_CRED_NAME
    vault-exec run github-pat -- gh api user
    vault-exec curl github-pat https://api.github.com/user
    vault-exec curl github-pat https://api.github.com/repos/x/y -X POST -d '{}'
"""

import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.parse

sys.path.insert(0, os.path.expanduser("~/.local/lib"))
import vaultlib as V  # noqa: E402

EXIT_OK = 0
EXIT_EXPIRED = 8
EXIT_USAGE = 2
EXIT_NO_CRED = 3
EXIT_HOST_DENIED = 4
EXIT_DECRYPT = 5
EXIT_BAD_TYPE = 6


def audit(action, cred, note="", host="-", path="-", status=0):
    """写审计。调用方必须保证 note 不含凭据值。

    host / path / status 是结构化字段（便于筛选统计），不要塞进 note。
    path 只记路径部分，不记 query（避免把查询参数里的敏感值写进日志）。
    """
    try:
        V.audit_event(action=action, cred=cred,
                      host=host or "-", path=path or "-",
                      status=status, note=note[:200])
    except Exception:
        pass


# ── 请求明细日志（net.log，仅 --log-request 时写）─────────────────────────
# 与 audit.log 分工：
#   audit.log   每次调用一条元信息（凭据名/host/status），轻量、总是写
#   net.log     --log-request 时额外记请求明细（脱敏 URL、耗时、大小）
# 两者都绝不写凭据值、请求头、响应体。

def _net_log_path():
    """net.log 与 audit.log 同目录，权限 600。"""
    return os.path.join(os.path.dirname(V.audit_log_path()), "net.log")


def _desensitize_url(url):
    """保留 scheme/host/path，query 的**值**替换为 ***，只暴露参数名。

    例：https://api.github.com/user?access_token=abc&page=2
       → https://api.github.com/user?access_token=***&page=***
    """
    try:
        p = urllib.parse.urlsplit(url)
    except ValueError:
        return "<unparsable-url>"
    if not p.scheme or not p.hostname:
        return "<unparsable-url>"
    q = ""
    if p.query:
        pairs = urllib.parse.parse_qsl(p.query, keep_blank_values=True)
        q = "&".join(f"{k}=***" for k, _ in pairs)
    netloc = p.hostname or ""
    if p.port:
        netloc = f"{netloc}:{p.port}"
    out = f"{p.scheme}://{netloc}{p.path or '/'}"
    if q:
        out += "?" + q
    return out


def _method_of(extra):
    """从 curl 参数推断 HTTP 方法（仅用于日志展示）。"""
    for i, a in enumerate(extra):
        if a in ("-X", "--request") and i + 1 < len(extra):
            return extra[i + 1].upper()
        if a.startswith("--request="):
            return a.split("=", 1)[1].upper()
    if any(a in ("-d", "--data", "--data-raw", "--data-binary", "-F", "--form")
           or a.startswith(("--data=", "--data-raw=", "--form=")) for a in extra):
        return "POST"
    if any(a in ("-I", "--head") for a in extra):
        return "HEAD"
    return "GET"


def _write_net_log(entry):
    """追加一条 JSON 行到 net.log。失败不影响主流程。"""
    path = _net_log_path()
    try:
        os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
        line = json.dumps(entry, ensure_ascii=False, separators=(",", ":")) + "\n"
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        try:
            os.write(fd, line.encode())
        finally:
            os.close(fd)
    except OSError:
        pass


def _load(cred):
    """读元数据 + 解密。返回 (meta, secret)。失败抛带 code 的异常。"""
    if not V.CREDNAME_RE.match(cred or ""):
        raise SystemExit(EXIT_NO_CRED)
    try:
        meta = V.load_meta(cred)
    except V.VaultError:
        sys.stderr.write(f"vault-exec: 凭据不存在: {cred}\n")
        raise SystemExit(EXIT_NO_CRED)
    _lease, _left = V.lease_state(meta)
    if _lease == "expired":
        sys.stderr.write(
            f"vault-exec: 凭据已过期（租约 {meta.get('lease_days')} 天，"
            f"超期 {_left} 天）——先轮换: vault-cred rotate {cred}\n")
        audit("exec_lease_expired", cred, note=f"overdue={_left}d")
        raise SystemExit(EXIT_EXPIRED)

    try:
        secret = V.load_secret(cred)
    except V.VaultError as e:
        sys.stderr.write(f"vault-exec: 解密失败（{e.code}）\n")
        audit("exec_decrypt_fail", cred, note=e.code)
        raise SystemExit(EXIT_DECRYPT)
    return meta, secret


def _host_of(url):
    p = urllib.parse.urlparse(url)
    host = (p.hostname or "").lower()
    return host


def cmd_run(argv):
    """vault-exec run <凭据名> -- <命令...>"""
    if "--" not in argv:
        sys.stderr.write("用法: vault-exec run <凭据名> -- <命令...>\n")
        return EXIT_USAGE
    sep = argv.index("--")
    cred = argv[0] if sep > 0 else None
    cmd = argv[sep + 1:]
    if not cred or not cmd:
        sys.stderr.write("用法: vault-exec run <凭据名> -- <命令...>\n")
        return EXIT_USAGE

    meta, secret = _load(cred)
    ctype = meta.get("type", "")
    if ctype not in V.SUPPORTED_TYPES:
        sys.stderr.write(f"vault-exec: 不支持的凭据类型 {ctype}\n")
        return EXIT_BAD_TYPE

    env = os.environ.copy()
    # 统一变量
    env["VAULT_SECRET"] = secret
    env["VAULT_CRED_TYPE"] = ctype
    env["VAULT_CRED_NAME"] = cred
    # 按 meta 配置的 env 名额外注入（如 env_name: GITHUB_TOKEN）
    env_name = meta.get("env_name")
    if env_name:
        env[env_name] = secret
    # 按类型给惯用变量名
    if ctype == "bearer":
        env.setdefault("VAULT_BEARER_TOKEN", secret)
    elif ctype == "basic":
        env.setdefault("VAULT_BASIC_AUTH", secret)
    elif ctype == "header":
        env.setdefault("VAULT_HEADER_VALUE", secret)
        env.setdefault("VAULT_HEADER_NAME", meta.get("header_name") or "X-Api-Key")
    elif ctype == "query":
        env.setdefault("VAULT_QUERY_VALUE", secret)
        env.setdefault("VAULT_QUERY_NAME", meta.get("param_name") or "api_key")

    secret = None  # 尽早丢弃本进程引用

    cmd_name = os.path.basename(cmd[0])
    try:
        proc = subprocess.run(cmd, env=env)
        rc = proc.returncode
    except FileNotFoundError:
        sys.stderr.write(f"vault-exec: 命令不存在: {cmd[0]}\n")
        rc = EXIT_USAGE
    except KeyboardInterrupt:
        rc = 130

    audit("exec_run", cred, note=f"cmd={cmd_name} rc={rc}")
    return rc


def cmd_curl(argv):
    """vault-exec curl <凭据名> <url> [--log-request] [--allow-http-error] [curl 参数...]"""
    log_request = "--log-request" in argv
    allow_http_error = "--allow-http-error" in argv
    argv = [x for x in argv if x not in ("--log-request", "--allow-http-error")]
    if len(argv) < 2:
        sys.stderr.write(
            "用法: vault-exec curl <凭据名> <url> "
            "[--log-request] [--allow-http-error] [curl 参数...]\n")
        return EXIT_USAGE
    cred, url = argv[0], argv[1]
    extra = argv[2:]

    meta, secret = _load(cred)
    ctype = meta.get("type", "")
    if ctype not in V.SUPPORTED_TYPES:
        sys.stderr.write(f"vault-exec: 不支持的凭据类型 {ctype}\n")
        return EXIT_BAD_TYPE

    # 白名单校验（解密后立刻校验，失败即丢弃）
    host = _host_of(url)
    domains = meta.get("domains") or []
    if not V.host_matches_allowlist(host, domains):
        secret = None
        sys.stderr.write(f"vault-exec: 拒绝 —— {host} 不在 {cred} 的 domains 白名单内\n")
        audit("exec_host_denied", cred, host=host, note="host_not_allowed")
        return EXIT_HOST_DENIED

    # 构造 curl 参数：凭据只走 stdin 配置文件（不进 argv）
    # 用 curl 的 -K - （从 stdin 读配置）避免值出现在 ps
    cfg_lines = []
    if ctype == "bearer":
        cfg_lines.append(f'header = "Authorization: Bearer {secret}"')
    elif ctype == "basic":
        cfg_lines.append(f'user = "{secret}"')
    elif ctype == "header":
        hname = meta.get("header_name") or "X-Api-Key"
        cfg_lines.append(f'header = "{hname}: {secret}"')
    elif ctype == "query":
        pname = meta.get("param_name") or "api_key"
        sep = "&" if "?" in url else "?"
        url = url + sep + urllib.parse.urlencode({pname: secret})

    secret = None

    # 凭据配置写进 0600 临时文件（-K 读），用完立即删
    fd, cfgpath = tempfile.mkstemp(prefix="vault-exec-", suffix=".curlrc")
    # 响应头单独落到临时文件，用来取真实 HTTP 状态码（正文仍走 stdout，不缓冲）
    hfd, hdrpath = tempfile.mkstemp(prefix="vault-exec-", suffix=".hdr")
    http_code = 0
    size_bytes = -1
    duration_ms = 0
    rc = 1
    try:
        os.fchmod(fd, 0o600)
        os.fchmod(hfd, 0o600)
        os.close(hfd)
        with os.fdopen(fd, "w") as f:
            f.write("\n".join(cfg_lines) + "\n")
        # 正文原样流到 stdout；状态码与大小都从响应头文件取（不碰 stdout）
        fail_flag = [] if allow_http_error else ["--fail-with-body"]
        cmd = (["curl", "-sS", "-D", hdrpath, "-K", cfgpath]
               + fail_flag + extra + [url])
        t0 = time.monotonic()
        try:
            proc = subprocess.run(cmd)
            rc = proc.returncode
        except KeyboardInterrupt:
            rc = 130
        duration_ms = int((time.monotonic() - t0) * 1000)
        # 解析响应头：取最后一个状态行（考虑 100-continue / 重定向）+ Content-Length
        try:
            with open(hdrpath, "r", errors="replace") as hf:
                for line in hf:
                    if line.startswith("HTTP/"):
                        parts = line.split()
                        if len(parts) >= 2 and parts[1].isdigit():
                            http_code = int(parts[1])
                    elif line.lower().startswith("content-length:"):
                        val = line.split(":", 1)[1].strip()
                        if val.isdigit():
                            size_bytes = int(val)
        except OSError:
            pass
    finally:
        for pth in (cfgpath, hdrpath):
            try:
                os.unlink(pth)
            except OSError:
                pass

    # 只记路径，不记 query（query 可能含敏感参数）
    req_path = urllib.parse.urlparse(url).path or "/"
    audit("exec_curl", cred, host=host, path=req_path,
          status=http_code, note=f"rc={rc}")

    # 请求明细：仅 --log-request 时写，URL 的 query 值已脱敏
    if log_request:
        _write_net_log({
            "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            "cred": cred,
            "method": _method_of(extra),
            "url": _desensitize_url(url),
            "host": host,
            "status": http_code,
            "duration_ms": duration_ms,
            "size_bytes": size_bytes,
            "rc": rc,
        })
    return rc


def usage():
    print(__doc__)
    return EXIT_USAGE


def main():
    a = sys.argv[1:]
    if not a:
        return usage()
    mode = a[0]
    if mode == "run":
        return cmd_run(a[1:])
    if mode == "curl":
        return cmd_curl(a[1:])
    if mode in ("-h", "--help", "help"):
        return usage()
    sys.stderr.write(f"vault-exec: 未知子命令 {mode}\n")
    return usage()


if __name__ == "__main__":
    sys.exit(main())
