#!/usr/bin/env python3
"""accounts — 账号资产库查询（读 ~/.deepseekbot/accounts.yaml）

用法:
  accounts list                     所有账号一览
  accounts show <id>                某个账号详情（含依赖）
  accounts login <id>               怎么登录它（含 OAuth 链路）
  accounts impact <id>              这个挂了会影响谁
  accounts todo                     待补项
  accounts secrets                  用到的 Secrets key 清单
  accounts json                     JSON 输出（给程序用）
"""
import sys, os, json
import yaml

PATH = os.path.expanduser("~/.deepseekbot/accounts.yaml")


def load():
    with open(PATH) as f:
        return yaml.safe_load(f)


def all_items(d):
    out = {}
    for k in ("identities", "platforms"):
        for it in d.get(k) or []:
            out[it["id"]] = it
    return out


def label(it):
    return it.get("name") or it.get("address") or it["id"]


def cmd_list(d):
    items = all_items(d)
    print(f"{'ID':16}{'账号/平台':34}{'用途'}")
    print("-" * 92)
    for k in ("identities", "platforms"):
        for it in d.get(k) or []:
            print(f"{it['id']:16}{label(it)[:32]:34}{(it.get('purpose') or '')[:40]}")
    print(f"\n共 {len(items)} 项  |  最后更新 {d.get('meta',{}).get('last_updated','?')}")


def cmd_show(d, aid):
    items = all_items(d)
    it = items.get(aid)
    if not it:
        print("没有这个 id:", aid); return
    print(json.dumps(it, ensure_ascii=False, indent=2))
    # 反向依赖
    deps = d.get("dependency_chains") or {}
    for k, v in deps.items():
        if aid in (v.get("fails_if_lost") or []) or aid in (v.get("affects") or []) or aid in (v.get("fails_if_lost") or []):
            print(f"\n⚠ 受 {k} 影响")
    for k, v in deps.items():
        if k == aid:
            print(f"\n⚠ {aid} 挂了会影响: {v}")


def cmd_login(d, aid):
    items = all_items(d)
    it = items.get(aid)
    if not it:
        print("没有这个 id:", aid); return
    lg = it.get("login") or {}
    print(f"【{label(it)}】怎么登录：")
    if lg.get("method") == "oauth":
        via = lg.get("via")
        vianame = label(items[via]) if via in items else via
        print(f"  ① 先登录 {vianame}（{via}）")
        print(f"  ② 在 {label(it)} 点「用 {vianame} 授权登录」")
        if lg.get("backup_identity"):
            b = items.get(lg["backup_identity"], {})
            print(f"  备选：用 {b.get('address', lg['backup_identity'])} 找回")
    else:
        ident = lg.get("identity")
        if ident and ident in items:
            print(f"  ① 邮箱：{items[ident].get('address')}")
        elif lg.get("email"):
            print(f"  ① 邮箱：{lg['email']}")
        print(f"  ② 密码：见 {it.get('password_ref') or '（未记录）'}")
    tf = it.get("2fa") or {}
    if tf.get("app"):
        print(f"  ③ 2FA：{tf.get('app')} 里找「{tf.get('label')}」")
    else:
        print(f"  ③ 2FA：未记录 ⚠")


def cmd_impact(d, aid):
    deps = d.get("dependency_chains") or {}
    items = all_items(d)
    hit = []
    for k, v in deps.items():
        if k == aid:
            for x in (v.get("fails_if_lost") or []) + (v.get("affects") or []):
                hit.append((x, "直接依赖"))
    # 递归一层
    for x, _ in list(hit):
        for k, v in deps.items():
            if k == x:
                for y in v.get("fails_if_lost") or []:
                    hit.append((y, f"经 {x} 间接"))
    print(f"【{aid}】出问题会影响：")
    if not hit:
        print("  无记录的下游依赖")
    for x, why in hit:
        print(f"  - {label(items.get(x, {'id': x}))}  ({why})")


def cmd_todo(d):
    for t in d.get("todo") or []:
        print(" •", t)


def cmd_secrets(d):
    items = all_items(d)
    keys = set()
    for it in items.values():
        if it.get("password_ref"):
            keys.add(it["password_ref"])
        r = it.get("recovery") or {}
        if r.get("codes_ref"):
            keys.add(r["codes_ref"])
    print("本库引用的 Secrets（用环境变量 $<key> 取）：")
    for k in sorted(keys):
        print("  ", k)


def main():
    if not os.path.exists(PATH):
        sys.exit("找不到 " + PATH)
    d = load()
    a = sys.argv[1:]
    if not a:
        cmd_list(d); return
    c = a[0]
    if c == "list": cmd_list(d)
    elif c == "show": cmd_show(d, a[1])
    elif c == "login": cmd_login(d, a[1])
    elif c == "impact": cmd_impact(d, a[1])
    elif c == "todo": cmd_todo(d)
    elif c == "secrets": cmd_secrets(d)
    elif c == "json": print(json.dumps(d, ensure_ascii=False, indent=2))
    else: print(__doc__)


if __name__ == "__main__":
    main()
