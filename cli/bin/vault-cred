#!/usr/bin/env python3
"""vault-cred — 账号执行层凭据管理

⚠ vault-proxy 常驻服务已停用（stop + disable），勿再启用：
  它监听 127.0.0.1:48771 且无调用方认证，同用户任意进程可用真实凭据。
  日常调用请用 `vault-exec run|curl`（按需注入，用完即失效）。
  本工具的 add/list/rm/status/audit-verify 等管理命令不受影响。

用法
----
    vault-cred add <名字> <类型> --domains a.com,b.com [--header-name X-Api-Key] [--param-name api_key]
    vault-cred list
    vault-cred rm <名字>
    vault-cred test <名字> <host> <路径>

类型
----
    bearer  → Authorization: Bearer <值>
    basic   → Authorization: Basic base64(<值>)     # 值写成 user:pass
    header  → <header-name>: <值>
    query   → 拼到 URL 查询参数 <param-name>=<值>

安全
----
- 凭据值交互输入，不回显（getpass），不落 shell 历史
- 也可从 stdin 读（管道），便于自动化；但绝不从 argv 读
- 元数据（名字/类型/domains）明文存，供代理在解密前校验白名单
"""

import argparse
import json
import os
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request

sys.path.insert(0, os.path.expanduser("~/.local/lib"))
import vaultlib as V  # noqa: E402

PROXY = "http://127.0.0.1:48771"


def _read_secret(prompt):
    """优先 getpass（不回显）；非 TTY 则读 stdin。"""
    if sys.stdin.isatty():
        import getpass
        return getpass.getpass(prompt)
    return sys.stdin.read().strip()


def _die(msg):
    """统一的用户级错误退出（exit 2），不要用 NameError 暴露内部状态。"""
    print(f"vault-cred: {msg}", file=sys.stderr)
    sys.exit(2)


def cmd_add(args):
    name = args.name
    ctype = args.type

    if not V.CREDNAME_RE.match(name):
        sys.exit("凭据名只能用字母数字 . _ -，长度 1-64")
    if ctype not in V.SUPPORTED_TYPES:
        sys.exit("类型必须是: " + ", ".join(V.SUPPORTED_TYPES))

    domains = [d.strip().lower() for d in (args.domains or "").split(",") if d.strip()]
    if not domains and ctype not in V.NO_EXEC_TYPES:
        sys.exit("必须给 --domains（默认拒绝，白名单不能为空）")
    if ctype in V.NO_EXEC_TYPES:
        domains = []       # totp 不发网络请求，白名单无意义

    meta = {
        "name": name,
        "type": ctype,
        "domains": domains,
        "created_at": int(__import__("time").time()),
    }
    if ctype in V.NO_LEASE_TYPES:
        meta["lease_days"] = 0        # 种子不过期
    else:
        meta["lease_days"] = getattr(args, "lease_days", V.LEASE_DEFAULT_DAYS)
    if ctype == "header":
        if not args.header_name:
            sys.exit("header 类型必须给 --header-name")
        meta["header_name"] = args.header_name
    if ctype == "query":
        if not args.param_name:
            sys.exit("query 类型必须给 --param-name")
        meta["param_name"] = args.param_name

    if V.meta_exists(name) and not args.force:
        sys.exit(f"凭据 {name} 已存在；要覆盖请加 --force")

    hint = "输入凭据值（不回显）: " if ctype != "basic" else "输入 user:pass（不回显）: "
    value = _read_secret(hint)
    if not value:
        sys.exit("凭据值为空，未保存")

    V.save_secret(name, value)
    V.save_meta(meta)
    value = None  # 丢弃

    print(f"✓ 已保存凭据 {name}")
    print(f"  类型: {ctype}")
    print(f"  域名白名单: {', '.join(domains)}")
    if ctype == "header":
        print(f"  注入头: {meta['header_name']}")
    if ctype == "query":
        print(f"  查询参数: {meta['param_name']}")
    if ctype in V.NO_EXEC_TYPES:
        print("  这一类是第二因素种子：不能 exec、不发网络请求、没有租约")
        print(f"  用法: vault-login <会话名> --url <登录页> --cred <账号密码凭据> --totp {name}")
        print("  提醒: 种子与密码同库，安全性不因此提高，提高的是自动化。")
    else:
        print(f"  用法（推荐，按需注入）: vault-exec curl {name} https://<host>/<path>")
        print(f"  给老格式凭据补作用域: vault-cred scope {name} --methods GET,POST --paths /repos/")


GITHUB_API = os.environ.get("DSH_ID_GITHUB_API", "https://api.github.com")


def _b64u(raw):
    import base64
    return base64.urlsafe_b64encode(raw).rstrip(b"=").decode()


def _github_app_jwt(app_id, key_path):
    """RS256 JWT（10 分钟上限；GitHub 要求 exp ≤ 10min）。用 openssl 签，免装 cryptography。"""
    import subprocess as _sp
    import time as _t
    head = _b64u(json.dumps({"alg": "RS256", "typ": "JWT"}, separators=(",", ":")).encode())
    payload = _b64u(json.dumps({"iat": int(_t.time()) - 60,
                                "exp": int(_t.time()) + 540,
                                "iss": str(app_id)}, separators=(",", ":")).encode())
    signing_input = f"{head}.{payload}".encode()
    r = _sp.run(["openssl", "dgst", "-sha256", "-sign", key_path],
                input=signing_input, capture_output=True)
    if r.returncode != 0:
        raise SystemExit("openssl 签名失败: " + r.stderr.decode()[:200])
    return f"{head}.{payload}.{_b64u(r.stdout)}"


def cmd_mint(args):
    """用 GitHub App 换 1 小时令牌，写进保险库（到期自动失效，不必长期保存 pat）。"""
    if not os.path.exists(args.key):
        _die(f"私钥不存在: {args.key}")
    try:
        jwt = _github_app_jwt(args.app_id, args.key)
    except SystemExit as e:
        _die(str(e))
    url = f"{GITHUB_API}/app/installations/{args.installation}/access_tokens"
    import urllib.request as _u
    import urllib.error as _ue
    req = _u.Request(url, method="POST", headers={
        "Authorization": f"Bearer {jwt}", "Accept": "application/vnd.github+json",
        "User-Agent": "dsh-id", "Content-Length": "0"})
    try:
        with _u.urlopen(req, timeout=15) as r:
            body = json.load(r)
    except _ue.HTTPError as e:
        _die(f"GitHub 拒绝（HTTP {e.code}）: {e.read()[:200].decode(errors='replace')}")
    except Exception as e:
        _die(f"请求失败: {e}")
    token = body.get("token")
    if not token:
        _die("GitHub 没返回 token")
    name = args.name
    # 覆盖写入：短时令牌，不需要租约（expires_at 由 GitHub 决定）
    meta = {"name": name, "type": "bearer",
            "domains": [d.strip() for d in args.domains.split(",") if d.strip()],
            "created_at": int(__import__("time").time()), "lease_days": 0,
            "minted": "github-app", "app_id": str(args.app_id),
            "installation": str(args.installation),
            "expires_at": body.get("expires_at")}
    V.save_secret(name, token)
    V.save_meta(meta)
    V.app_log("mint", cred=name, provider="github-app", expires=body.get("expires_at"))
    V.audit_event(action="mint", cred=name, host=meta["domains"][0] if meta["domains"] else "-",
                  path="-", status=0, note="github-app token")
    exp = body.get("expires_at", "?")
    print(f"✓ 已签发 {name}（GitHub App 安装令牌，GitHub 侧到期: {exp}）")
    print(f"  白名单: {', '.join(meta['domains'])}")
    print(f"  用: dsh-id exec {name} https://api.github.com/user")


def cmd_rotate(args):
    """只换值，不换身份：类型/白名单/租约都保留，created_at 重置。"""
    name = args.name
    try:
        meta = V.load_meta(name)
    except V.VaultError:
        _die(f"凭据不存在: {name}（新增用 vault-cred add）")
    if meta.get("type") in V.NO_EXEC_TYPES:
        print("提醒：这是第二因素种子。换掉它等于更换 2FA，必须同时在平台上重新绑定，")
        print("      否则这个账号会立刻登不进去。继续请重跑并加 --force。")
        if not getattr(args, "force", False):
            sys.exit(10)
    hint = "输入新凭据值（不回显）: " if meta.get("type") != "basic" else "输入 user:pass（不回显）: "
    value = _read_secret(hint)
    if not value:
        _die("值为空，未轮换")
    V.save_secret(name, value)
    meta["created_at"] = int(__import__("time").time())
    meta["rotated_at"] = meta["created_at"]
    if getattr(args, "lease_days", None) is not None:
        meta["lease_days"] = args.lease_days
    V.save_meta(meta)
    V.audit_event(action="rotate", cred=name, host="-", path="-", status=0,
                  note=f"lease={meta.get('lease_days')}")
    V.app_log("rotate", cred=name)
    if meta.get("type") in V.NO_LEASE_TYPES:
        print(f"✓ 已更换 {name} 的种子（无租约；记得去平台重新绑定）")
    else:
        print(f"✓ 已轮换 {name}（租约 {meta.get('lease_days')} 天，从今天重新计）")


def cmd_lease(args):
    """给已有凭据设/改租约（老凭据没有 lease_days 字段）。"""
    name = args.name
    try:
        meta = V.load_meta(name)
    except V.VaultError:
        _die(f"凭据不存在: {name}")
    if meta.get("type") in V.NO_LEASE_TYPES:
        _die(f"{name} 是第二因素种子，没有租约；作废一个种子等于锁死账号，"
             "要换就 rotate（并去平台重新绑定）")
    days = args.days
    if days is not None:
        if days < 0:
            _die("租约天数不能是负数")
        meta["lease_days"] = days
    if args.reset:
        meta["created_at"] = int(__import__("time").time())
    elif not args.days and "lease_days" not in meta:
        _die("没有可改的租约；用 --days N 指定（0=取消租约）")
    V.save_meta(meta)
    state, left = V.lease_state(meta)
    tail = (f"剩 {left} 天" if state == "ok" else
            f"已过期 {abs(left)} 天" if state == "expired" else "无租约")
    V.audit_event(action="lease_set", cred=name, host="-", path="-", status=0,
                  note=f"lease_days={meta.get('lease_days')} reset={args.reset}")
    V.app_log("lease", cred=name, days=meta.get("lease_days"))
    print(f"✓ {name}: 租约 {meta.get('lease_days')} 天（{tail}）")


def cmd_list(args):
    creds = V.list_credentials()
    if not creds:
        print("（无凭据）")
        return
    print(f"{'名字':<22}{'类型':<10}{'域名白名单':<30}{'租约':<12}{'作用域'}")
    print("-" * 92)
    for c in creds:
        ctype = c.get("type", "?")
        if ctype in V.NO_EXEC_TYPES:
            domains = "（第二因素 · 不发网络请求）"
        else:
            domains = ", ".join(c.get("domains") or []) or "（空 · 全部拒绝）"
        state, left = V.lease_state(c)
        if ctype in V.NO_LEASE_TYPES:
            tail = "无租约"
        elif state == "ok":
            tail = f"剩 {left} 天"
        elif state == "expired":
            tail = f"已过期 {abs(left)} 天"
        else:
            tail = "无租约"
        sc = V.scope_of(c)
        scope = "未收紧"
        if sc["methods"] or sc["paths"]:
            scope = "%s %s" % (",".join(sc["methods"]) or "*", ",".join(sc["paths"]) or "*")
        if c.get("legacy_file"):
            scope += " · 归档"
        print(f"{c.get('name', '?'):<22}{ctype:<10}{domains:<30}{tail:<12}{scope}")


def cmd_rm(args):
    removed = V.remove_credential(args.name)
    if removed:
        print(f"✓ 已删除凭据 {args.name}（{len(removed)} 个文件）")
    else:
        print(f"凭据 {args.name} 不存在")


# 平台吊销入口：域名后缀 → (平台名, token 吊销页, 会话登出页)。None = 该平台没有这类页面。
REVOKE_MAP = {
    "github.com": ("GitHub", "https://github.com/settings/tokens",
                   "https://github.com/settings/sessions"),
    "cloudflare.com": ("Cloudflare", "https://dash.cloudflare.com/profile/api-tokens",
                       "https://dash.cloudflare.com/profile"),
    "vercel.com": ("Vercel", "https://vercel.com/account/tokens",
                   "https://vercel.com/account/sessions"),
    "openai.com": ("OpenAI", "https://platform.openai.com/api-keys",
                   "https://chatgpt.com/#settings/Security"),
    "anthropic.com": ("Anthropic", "https://console.anthropic.com/settings/keys", None),
    "chatgpt.com": ("ChatGPT", None, "https://chatgpt.com/#settings/Security"),
    "googleapis.com": ("Google", "https://myaccount.google.com/permissions",
                       "https://myaccount.google.com/deviceactivity"),
    "google.com": ("Google", "https://myaccount.google.com/permissions",
                   "https://myaccount.google.com/deviceactivity"),
    "x.com": ("X", "https://developer.x.com/en/portal/projects-and-apps",
              "https://x.com/settings/sessions"),
    "twitter.com": ("X", "https://developer.x.com/en/portal/projects-and-apps",
                    "https://x.com/settings/sessions"),
    "slack.com": ("Slack", "https://api.slack.com/apps", None),
    "huggingface.co": ("Hugging Face", "https://huggingface.co/settings/tokens", None),
    "modelscope.cn": ("ModelScope", "https://www.modelscope.cn/my/myaccesstoken", None),
    "deepseek.com": ("DeepSeek", "https://platform.deepseek.com/api_keys", None),
    "amazonaws.com": ("AWS",
                      "https://console.aws.amazon.com/iam/home#/security_credentials", None),
    "notion.so": ("Notion", "https://www.notion.so/my-integrations", None),
    "stripe.com": ("Stripe", "https://dashboard.stripe.com/apikeys", None),
}


def _platform_key(host):
    """把域名映射到吊销表里的后缀；认不出返回 None。"""
    h = (host or "").strip().lower().split(":")[0].lstrip(".")
    if not h:
        return None
    for suf in sorted(REVOKE_MAP, key=len, reverse=True):
        if h == suf or h.endswith("." + suf):
            return suf
    return None


def _as_list(v):
    if v is None:
        return []
    if isinstance(v, str):
        return [x for x in (s.strip() for s in v.split(",")) if x]
    return [x for x in v if x]


def _group(items, keyfn):
    out = {}
    for it in items:
        out.setdefault(keyfn(it), []).append(it)
    return out


def build_revoke_report(creds, sessions, reason="panic"):
    """生成「上游还没停」清单。只写名字/域名，绝不涉及凭据值。"""
    import datetime as _dt
    now_s = _dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    L = ["# 待吊销清单", "",
         f"生成时间: {now_s}",
         f"触发原因: {reason}", "",
         "> panic 只隔离了**本地**密文。下面这些在平台上依然有效，",
         "> 要你自己去各自后台吊销/登出，否则拿旧凭据的人照样能用。", ""]

    if creds:
        L += [f"## 凭据（{len(creds)} 个）", ""]
        for plat, items in _group(creds, lambda c: _platform_key(
                (_as_list(c.get("domains")) or [""])[0])).items():
            title = REVOKE_MAP[plat][0] if plat else "未识别平台"
            L.append(f"- **{title}**：" + "、".join(c.get("name", "?") for c in items))
            if plat:
                _, token_url, _ = REVOKE_MAP[plat]
                if token_url:
                    L.append(f"  - 吊销: {token_url}")
            else:
                hosts = sorted({h for c in items for h in _as_list(c.get("domains"))})
                L.append("  - 吊销: 去该平台「API keys / 开发者设置」删掉"
                         + (f"（{', '.join(hosts)}）" if hosts else ""))
        L.append("")
    else:
        L += ["## 凭据（0 个）", ""]

    if sessions:
        L += [f"## 网页会话（{len(sessions)} 个）", ""]
        for plat, items in _group(sessions, lambda s: _platform_key(s.get("domain"))).items():
            title = REVOKE_MAP[plat][0] if plat else "未识别站点"
            L.append(f"- **{title}**：" + "、".join(s.get("name", "?") for s in items))
            if plat and REVOKE_MAP[plat][2]:
                L.append(f"  - 登出全部设备: {REVOKE_MAP[plat][2]}")
            else:
                doms = sorted({s.get("domain", "?") for s in items})
                L.append(f"  - 登出: 去 {', '.join(doms)} 的「设置 → 安全/会话」逐个登出")
        L.append("")
    else:
        L += ["## 网页会话（0 个）", ""]

    L += ["## 做完之后", "",
          "- 本地恢复: `dsh-id creds restore`",
          "- 再看一遍漏没漏: `dsh-id creds revoke-list`", ""]
    return "\n".join(L)


def write_revoke_report(path, creds=None, sessions=None, reason="panic"):
    creds = V.list_credentials() if creds is None else creds
    sessions = V.list_sessions() if sessions is None else sessions
    text = build_revoke_report(creds, sessions, reason=reason)
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
    return path, len(creds), len(sessions)


def print_revoke_summary(path, n_cred, n_sess, creds, sessions):
    """终端只报摘要 + 直达链接，详情在文件里。"""
    print()
    print("【上游还没停】")
    print(f"  ⚠ {n_cred} 个凭据 + {n_sess} 个会话在平台上依然有效，panic 管不到")
    print(f"  清单: {path}")
    for plat, items in _group(creds, lambda c: _platform_key(
            (_as_list(c.get("domains")) or [""])[0])).items():
        if plat and REVOKE_MAP[plat][1]:
            print(f"  - {REVOKE_MAP[plat][0]:<12} " + "、".join(c.get("name", "?") for c in items)
                  + f"  →  {REVOKE_MAP[plat][1]}")
        else:
            print(f"  - {'未识别平台':<10} " + "、".join(c.get("name", "?") for c in items)
                  + "  →  去该平台后台删 key")
    for plat, items in _group(sessions, lambda s: _platform_key(s.get("domain"))).items():
        if plat and REVOKE_MAP[plat][2]:
            print(f"  - {REVOKE_MAP[plat][0] + ' 会话':<12} " + "、".join(s.get("name", "?") for s in items)
                  + f"  →  {REVOKE_MAP[plat][2]}")
        else:
            print(f"  - {'会话':<10} " + "、".join(s.get("name", "?") for s in items)
                  + "  →  去各站「设置 → 会话」登出")


def cmd_revoke_list(args):
    path = args.out or os.path.join(V._vault_dir(), "REVOKE.md")
    path, nc, ns = write_revoke_report(path, reason="手动生成")
    print(f"已生成: {path}")
    print(f"涉及 {nc} 个凭据、{ns} 个会话（只含名字与域名，不含任何凭据值）")
    if not nc and not ns:
        print("（没有需要吊销的东西）")


def cmd_panic(args):
    res = V.panic(dry_run=args.dry_run)

    if args.dry_run:
        print("=== panic --dry-run（未做任何改动）===")
        print(f"会停止服务:   {V.SERVICE}")
        print(f"会禁用服务:   {V.SERVICE}（重启机器也不会自愈）")
        print(f"会隔离密文:   {len(res['secrets'])} 个")
        for s in res["secrets"]:
            print(f"  - {s}")
        print(f"隔离目录:     {res['quarantine_dir']}")
        print()
        _tmp = os.path.join(tempfile.gettempdir(), "dsh-id-revoke-preview.md")
        try:
            _p, _nc, _ns = write_revoke_report(_tmp, reason="panic --dry-run 预览")
            print_revoke_summary(_p, _nc, _ns, V.list_credentials(), V.list_sessions())
        except Exception as exc:
            print(f"⚠ 预览生成失败: {exc}")
        print()
        print("注意：vault.key 与元数据不会被删除，随时可恢复。")
        print("确认执行请运行: vault-cred panic")
        return

    V.app_log("panic", moved=len(res.get("moved") or []))
    print("=== PANIC 已执行 ===")
    if res["service_stopped"]:
        print("✓ 代理服务已停止（AI 立刻失去登录能力）")
    else:
        print(f"⚠ 服务停止失败: {res.get('service_error', '未知原因')}")
        print(f"  请手动确认: systemctl --user status {V.SERVICE}")

    if res.get("service_disabled"):
        print("✓ 服务已禁用（重启机器也不会自愈，必须人工恢复）")
    else:
        print(f"⚠ 服务禁用失败: {res.get('disable_error', '未知原因')}")

    print(f"✓ 已隔离 {len(res['moved'])} 个凭据密文 → {res['quarantine_dir']}")
    for m in res["moved"]:
        print(f"  - {m}")
    if res["failed"]:
        print(f"⚠ {len(res['failed'])} 个文件挪动失败:")
        for p, err in res["failed"]:
            print(f"  - {os.path.basename(p)}: {err}")

    try:
        _rp, _nc, _ns = write_revoke_report(
            os.path.join(res["quarantine_dir"], "REVOKE.md"), reason="panic")
        print_revoke_summary(_rp, _nc, _ns, V.list_credentials(), V.list_sessions())
    except Exception as exc:  # 清单生成失败不能盖住 panic 的结果
        print(f"⚠ 待吊销清单生成失败: {exc}")

    print()
    print("恢复方法: vault-cred restore")
    print("（会自动挪回密文、重新启用并启动服务、验证一次调用）")
    print()
    print("vault.key 未被动过，密文仍可解密，恢复后立即可用。")


def cmd_restore(args):
    if args.list:
        dirs = V.list_quarantines()
        if not dirs:
            print("（没有可恢复的隔离目录）")
            return
        print(f"可恢复的隔离目录（共 {len(dirs)} 个，最新的在前）:")
        print(f"{'时间戳':<20}{'凭据数':<8}{'凭据'}")
        print("-" * 68)
        for d in dirs:
            names = ", ".join(f[:-len(".secret.enc")] for f in d["files"]) or "（空）"
            print(f"{d['stamp']:<20}{d['count']:<8}{names}")
        print()
        print("恢复最新:   vault-cred restore")
        print("恢复指定:   vault-cred restore <时间戳>")
        return

    res = V.restore(stamp=args.stamp)

    if res["error"] and not res["restored"]:
        sys.exit("✗ " + res["error"])

    print("=== RESTORE ===")
    print(f"隔离目录: {res['quarantine_dir']}")
    print(f"✓ 已挪回 {len(res['restored'])} 个凭据密文")
    for fn in res["restored"]:
        print(f"  - {fn}")
    if res["failed"]:
        print(f"⚠ {len(res['failed'])} 个文件恢复失败:")
        for fn, err in res["failed"]:
            print(f"  - {fn}: {err}")

    # 隔离目录清理结果
    if res.get("dir_removed"):
        if res.get("revoke_report_kept"):
            print(f"✓ 待吊销清单已留档: {res['revoke_report_kept']}（隔离目录已删）")
        else:
            print("✓ 隔离目录已空，已自动删除")
    elif res.get("dir_kept"):
        left = res.get("dir_leftovers") or []
        print(f"⚠ 隔离目录未删（仍有 {len(left)} 项）: {', '.join(left) or '未知'}")

    if res["service_enabled"]:
        print(f"✓ 服务已 enable --now: {V.SERVICE}")
    else:
        print(f"⚠ 服务启动失败: {res.get('error', '未知原因')}")

    state = "active" if res["service_active"] else "inactive"
    print(f"  当前状态: {state}")

    # 探针只是加分项：服务起来了就不算失败
    if res["verify_code"]:
        code = res["verify_code"]
        target = f"{res.get('verify_host', '')}{res.get('verify_path', '')}"
        if 200 <= code < 400:
            print(f"✓ 探针通过: {res['verify_cred']} → GET {target} = HTTP {code}")
        else:
            print(f"  服务已启动，探针未通过（不影响使用）: "
                  f"{res['verify_cred']} → GET {target} = HTTP {code}")
    else:
        print("  （没有可探测的凭据，跳过探针）")

    if not res["ok"]:
        sys.exit(1)


def _guard_batch(action_desc):
    """批量高危操作的审批闸门。

    设计取舍：
      - 单个 rm / revoke 不拦（太频繁，会烦死老板）
      - **批量**（--all、多个名字）才拦
      - panic 不拦：它是救命命令，延误时机比误操作更危险
    返回 True 表示已批准可继续；否则打印原因并退出。
    """
    try:
        sys.path.insert(0, os.path.expanduser("~/.local/lib"))
        import guardlib as G
    except Exception:
        print("⚠ 审批模块不可用，为安全起见拒绝执行批量操作。")
        sys.exit(1)

    r = G.check(action_desc)
    if r["decision"] == "allow":
        return True

    print("⚠ 这是批量高危操作，需要老板批准后才能执行。")
    print(f"  操作: {action_desc}")
    print(f"  命中: {', '.join(r['hits'])}")
    print(f"  待批准 id: {r['id']}")
    print()
    print(f"  请老板执行: vault-guard approve {r['id']}")
    print(f"  批准后重新运行本命令，并加 --approval-id {r['id']}")
    sys.exit(10)


def _check_approval(approval_id):
    """校验 --approval-id 是否真的被批准过。"""
    if not approval_id:
        return False
    try:
        sys.path.insert(0, os.path.expanduser("~/.local/lib"))
        import guardlib as G
        return G.is_approved(approval_id)
    except Exception:
        return False


def cmd_revoke(args):
    # 批量吊销：必须过审批闸门
    if getattr(args, "all", False) or getattr(args, "names", None):
        names = list(args.names or [])
        if args.all:
            names = [c["name"] for c in V.list_credentials()]
        if not names:
            sys.exit("没有可吊销的凭据")

        # 审批条件：显式 --all（无论几个凭据）或多个名字。
        # 注意：不能只看 len(names) > 1 —— 只有 1 个凭据时 --all 同样是"全部"
        # 语义，必须拦。（这个 bug 实测踩过：--all 在单凭据时直接执行了）
        if args.all or len(names) > 1:
            desc = ("吊销全部凭据（%d 个）: %s" % (len(names), ", ".join(names[:6]))
                    if args.all else
                    "批量吊销 %d 个凭据: %s" % (len(names), ", ".join(names[:6])))
            if not _check_approval(getattr(args, "approval_id", None)):
                _guard_batch(desc)
                sys.exit(10)
            print(f"✓ 审批已通过（id: {args.approval_id}）")

        failed = []
        for n in names:
            ok, qdir, moved, err = V.revoke(n)
            if ok:
                print(f"✓ 已吊销 {n}（{len(moved)} 个文件）")
            else:
                failed.append((n, err))
                print(f"✗ {n}: {err}")
        if failed:
            sys.exit(f"{len(failed)} 个吊销失败")
        return

    ok, qdir, moved, err = V.revoke(args.name)
    if not ok:
        sys.exit("吊销失败: " + (err or "未知原因"))
    print(f"✓ 已吊销凭据 {args.name}（{len(moved)} 个文件）")
    print(f"  隔离目录: {qdir}")
    print("  恢复: 把上面的文件挪回 " + V.PROXY_DIR)
    print("  注意: 代理仍在运行，该凭据的密文已不在原位，无法再解密注入。")


def cmd_audit_verify(args):
    if getattr(args, "anchor", None):
        status, detail = V.verify_anchor(args.anchor)
        print(f"锚文件: {args.anchor}")
        print(("✓ " if status == "ok" else "✗ ") + detail)
        for line in _anchor_hint(status, detail):
            print("  " + line)
        sys.exit(0 if status == "ok" else 1)
    path = args.file or V.AUDIT_LOG
    ok, problems, total, legacy = V.verify_chain(path)
    print(f"审计日志: {path}")
    print(f"总行数: {total}  旧格式遗留行(无 hash，作为链起点): {legacy}")
    if ok is None:
        print("? 无法校验（不是健康，也不是被篡改）:")
        for _, msg in problems:
            print(f"  {msg}")
        sys.exit(1)
    if ok:
        print("✓ 哈希链完整，未被篡改")
        return
    print(f"✗ 发现 {len(problems)} 处问题:")
    for lineno, msg in problems:
        print(f"  第 {lineno} 行: {msg}")
    sys.exit(1)


def _ask_password(prompt="主密码: ", confirm=False):
    """交互读密码，不回显。非 TTY 时读 stdin（便于自动化测试）。"""
    import getpass
    if sys.stdin.isatty():
        p1 = getpass.getpass(prompt)
        if confirm:
            p2 = getpass.getpass("再输一次确认: ")
            if p1 != p2:
                sys.exit("两次输入不一致")
        return p1
    return sys.stdin.readline().rstrip("\n")


def cmd_init(args):
    if V.master_enabled():
        sys.exit("主密码已设置过；改密码用 vault-cred passwd")
    print("=== 设置主密码 ===")
    print("主密码用于解锁保险库。忘记它只能靠恢复码，请务必记牢。")
    print("（输入不回显）")
    pw = _ask_password("设置主密码: ", confirm=True)
    if len(pw) < 8:
        sys.exit("主密码至少 8 位")
    meta = V.init_master(pw, timeout_minutes=args.timeout)
    pw = None
    print()
    print("✓ 主密码已设置")
    print(f"✓ 明文 vault.key 已删除，磁盘上只留被包裹的 vault.key.enc")
    print(f"✓ 自动锁定超时: {meta['timeout_minutes']} 分钟")
    print(f"✓ 当前已解锁")
    print()
    print("下一步强烈建议: vault-cred recovery-codes")
    try:
        V.audit_event(action="master_init", cred="-", host="-", path="-", status=0,
                      note="timeout=%s" % meta["timeout_minutes"])
    except Exception:
        pass


def cmd_unlock(args):
    if not V.master_enabled():
        sys.exit("尚未设置主密码，请先 vault-cred init")
    if not V.is_locked():
        ok, remain, _, _ = V.unlock_status()
        print(f"已经解锁（剩余 {remain // 60} 分钟）")
        return
    pw = _ask_password("主密码: ")
    ok = V.unlock(pw, timeout_minutes=args.timeout)
    pw = None
    if not ok:
        try:
            V.audit_event(action="unlock_failed", cred="-", host="-", path="-", status=401)
        except Exception:
            pass
        sys.exit("✗ 主密码错误")
    ok2, remain, exp, _ = V.unlock_status()
    print(f"✓ 已解锁，{remain // 60} 分钟内免密")
    try:
        V.audit_event(action="unlock", cred="-", host="-", path="-", status=0,
                      note="remain=%ds" % remain)
    except Exception:
        pass


def cmd_lock(args):
    removed = V.lock()
    if removed:
        print("✓ 已锁定（解锁态密钥已从内存盘删除）")
    else:
        print("已经是锁定状态")
    try:
        V.audit_event(action="lock", cred="-", host="-", path="-", status=0)
    except Exception:
        pass


def cmd_status(args):
    """状态总览。机器绑定是默认模式（AI 自理，无需人输密码）。"""
    machine = V.machine_enabled()
    master = V.master_enabled()

    # 实际能不能解密（最关键的判断）
    usable = True
    usable_src = "-"
    usable_err = None
    try:
        dek, src = V.current_dek()
        usable_src = src
    except V.VaultError as e:
        usable = False
        usable_err = str(e)

    print("=== 保险库状态 ===")
    print(f"当前可用:   {'✓ 可以解密（无需密码）' if usable else '✗ 不可用: ' + str(usable_err)}")
    if usable:
        label = {"machine": "机器绑定（自动解锁，无需密码）",
                 "session": "主密码解锁态",
                 "legacy": "旧版明文 key"}.get(usable_src, usable_src)
        print(f"解锁方式:   {label}")

    print(f"机器绑定:   {'✓ 已启用' if machine else '✗ 未启用'}")
    print(f"主密码:     {'✓ 已启用（可选加强项）' if master else '未启用（默认，AI 自理）'}")

    if master:
        unlocked, remain, exp, timeout = V.unlock_status()
        if unlocked and remain is not None:
            print(f"主密码态:   🔓 已解锁，剩余 {remain // 60} 分钟（超时 {timeout} 分钟）")
        else:
            print(f"主密码态:   🔒 已锁定（不影响机器绑定自动解锁）")

    if V.recovery_available():
        info = V.recovery_info() or {}
        print(f"恢复码:     ✓ 已生成（{info.get('count', 0)} 个）")
    else:
        print(f"恢复码:     未生成（主密码默认关闭，可不做）")

    print(f"凭据数:     {len(V.list_credentials())}")
    print(f"会话数:     {len(V.list_sessions())}")


def cmd_passwd(args):
    if not V.master_enabled():
        sys.exit("尚未设置主密码，请先 vault-cred init")
    print("=== 修改主密码 ===")
    old = _ask_password("当前主密码: ")
    new = _ask_password("新主密码: ", confirm=True)
    if len(new) < 8:
        sys.exit("新主密码至少 8 位")
    ok = V.change_password(old, new)
    old = new = None
    if not ok:
        sys.exit("✗ 当前主密码错误")
    print("✓ 主密码已修改，已重新解锁")
    print("  注意：恢复码仍然有效（它们独立包裹同一把密钥）")
    try:
        V.audit_event(action="master_passwd", cred="-", host="-", path="-", status=0)
    except Exception:
        pass


def cmd_timeout(args):
    if not V.master_enabled():
        sys.exit("尚未设置主密码")
    if args.minutes is None:
        meta = V.load_master_meta()
        print(f"当前自动锁定超时: {meta['timeout_minutes']} 分钟")
        print("修改: vault-cred timeout <分钟数>")
        return
    if args.minutes < 1:
        sys.exit("超时至少 1 分钟")
    meta = V.load_master_meta()
    meta["timeout_minutes"] = int(args.minutes)
    V.save_master_meta(meta)
    print(f"✓ 自动锁定超时已设为 {args.minutes} 分钟")
    print("  （对下一次 unlock 生效）")


def cmd_recovery_codes(args):
    if not V.master_enabled():
        sys.exit("请先设置主密码再生成恢复码")
    if V.is_locked():
        sys.exit("保险库已锁定，请先 vault-cred unlock")
    if V.recovery_available() and not args.force:
        info = V.recovery_info()
        sys.exit(f"恢复码已存在（{info['count']} 个，生成于 {info['created_at_str']}）。"
                 f"\n要重新生成请加 --force（旧的会全部作废）")

    codes = V.generate_recovery_codes(args.count)
    print()
    print("=" * 58)
    print("  紧急恢复码（每个只能用一次，请抄下来妥善保存）")
    print("=" * 58)
    print()
    for i, c in enumerate(codes, 1):
        print(f"  {i:2}.  {c}")
    print()
    print("=" * 58)
    print("  ⚠ 这些码只在屏幕上显示这一次，不会存明文到磁盘。")
    print("  ⚠ 主密码遗忘时，用任意一个码可重置主密码。")
    print("  ⚠ 请存到：密码管理器 / 打印后锁进抽屉 / 与主密码分开的地方。")
    print("=" * 58)
    print()
    try:
        V.audit_event(action="recovery_generate", cred="-", host="-", path="-",
                      status=0, note="count=%d" % len(codes))
    except Exception:
        pass


def cmd_recovery_reset(args):
    if not V.recovery_available():
        sys.exit("没有可用的恢复码，无法重置")
    print("=== 用恢复码重置主密码 ===")
    code = input("恢复码: ").strip() if sys.stdin.isatty() else sys.stdin.readline().strip()
    new = _ask_password("新主密码: ", confirm=True)
    if len(new) < 8:
        sys.exit("新主密码至少 8 位")
    ok, msg = V.reset_with_recovery_code(code, new)
    code = new = None
    if not ok:
        sys.exit("✗ " + msg)
    print("✓ " + msg)
    try:
        V.audit_event(action="recovery_reset", cred="-", host="-", path="-", status=0)
    except Exception:
        pass


def cmd_audit_report(args):
    r = V.audit_report()
    print("=" * 66)
    print(f"  保险库安全审计报告")
    print("=" * 66)
    print()
    bar_len = 30
    filled = int(round(bar_len * r["score"] / 100))
    bar = "█" * filled + "░" * (bar_len - filled)
    print(f"  健康分: {r['score']}/100  [{bar}]  {r['grade']}")
    print()
    print(f"  凭据 {r['counts']['credentials']} 个 · 会话 {r['counts']['sessions']} 个")
    print(f"  高风险 {r['counts']['high']} · 中风险 {r['counts']['medium']} · 低风险 {r['counts']['low']}")
    print(f"  主密码: {'已启用' if r['master_enabled'] else '未启用'}"
          f" · 恢复码: {'已生成' if r['recovery_available'] else '未生成'}"
          f" · 自动锁定: {r['timeout_minutes']} 分钟")
    print()
    if not r["findings"]:
        print("  ✓ 没有发现风险项")
    else:
        print("  风险清单:")
        order = {"high": 0, "medium": 1, "low": 2}
        icon = {"high": "🔴", "medium": "🟡", "low": "🔵"}
        for sev, cat, name, msg in sorted(r["findings"], key=lambda f: order[f[0]]):
            print(f"    {icon[sev]} [{cat}] {name}: {msg}")
    print()
    print("=" * 66)


def cmd_test(args):
    url = f"{PROXY}/{args.name}/{args.host}/{args.path.lstrip('/')}"
    req = urllib.request.Request(url, method="GET")
    print(f"→ GET {url}")
    try:
        with urllib.request.urlopen(req, timeout=35) as r:
            body = r.read()
            print(f"← HTTP {r.status} {r.reason}")
            ctype = r.headers.get("Content-Type", "")
            print(f"  Content-Type: {ctype}")
            text = body.decode("utf-8", "replace")
            print("  响应前 400 字符:")
            print(text[:400])
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", "replace")
        print(f"← HTTP {e.code} {e.reason}")
        print("  " + body[:400])
        sys.exit(1)
    except urllib.error.URLError as e:
        sys.exit(f"连不上代理（服务没起？）: {e.reason}")


def _anchor_hint(status, detail):
    if status == "ok":
        return ["链条与锚一致；后面新写的行不会影响这条结论。"]
    if status == "truncated":
        return ["日志比锚短：有行被删掉了。锚是机外副本，它是准的。"]
    return ["同样行数但链头不同：历史被重写过。别信这份日志，看锚。"]


def cmd_adopt(args):
    """把老格式裸密文登记进索引（只补元数据，不重新加密）。"""
    items = V.legacy_files()
    if not items:
        print("没有需要归档的老格式密文")
        return
    print(f"发现 {len(items)} 个未入索引的老格式密文：")
    for it in items:
        print(f"  {it['file']:<28} → 名字 {it['name']:<20} 类型 "
              f"{V.LEGACY_KIND_TYPE.get(it['kind'], 'bearer')}")
    results = V.adopt_legacy(dry_run=args.dry_run)
    if args.dry_run:
        print("（dry-run，没有写入）")
        return
    for name, kind, action in results:
        print(("✓ 已归档 " if action == "adopted" else "· 已在索引 ") + name)
    print(f"完成：{sum(1 for _,_,a in results if a == 'adopted')} 个已入索引，密文本字节未改动。")


def cmd_scope(args):
    """给凭据收紧 HTTP 作用域（method + 路径前缀）。"""
    def _split(v):
        if v is None:
            return None
        return [x.strip() for x in str(v).split(",") if x.strip()]
    try:
        meta = V.set_scope(args.name, methods=_split(args.methods), paths=_split(args.paths))
    except V.VaultError as e:
        sys.exit(str(e))
    sc = V.scope_of(meta)
    V.audit_event(action="scope_set", cred=args.name, host="-", path="-", status=0,
                  note="methods=%s paths=%s" % (",".join(sc["methods"]) or "*",
                                                ",".join(sc["paths"]) or "*"))
    V.app_log("scope", cred=args.name)
    print(f"✓ {args.name} 作用域：方法 {','.join(sc['methods']) or '*'} · "
          f"路径前缀 {', '.join(sc['paths']) or '*（全部）'}")
    if not sc["methods"] and not sc["paths"]:
        print("  （两边都空 = 不限，等于没收紧）")


def cmd_anchor(args):
    """导出/核对审计链头（机外锚定）。"""
    if args.check:
        status, detail = V.verify_anchor(args.check)
        print(("✓ " if status == "ok" else "✗ ") + detail)
        sys.exit(0 if status == "ok" else 1)
    out = args.out or os.path.expanduser("~/.dsh/log/dsh-id-audit-anchor.json")
    rec = V.audit_anchor(out)
    print(f"✓ 锚已写出: {out}")
    print(f"  行数 {rec['rows']} · 链头 {rec['head'][:16]}… · 链状态 "
          f"{'ok' if rec['chain_ok'] else '异常'}")
    print("  把这份文件放到机外（密码管理器/另一台机器）；核对：vault-cred audit-verify --anchor <文件>")


def main():
    ap = argparse.ArgumentParser(
        prog="vault-cred", description="账号执行层凭据管理")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p_add = sub.add_parser("add", help="新增凭据（交互输入值，不回显）")
    p_add.add_argument("name")
    p_add.add_argument("type", choices=V.SUPPORTED_TYPES)
    p_add.add_argument("--domains", default="",
                       help="域名白名单，逗号分隔；支持 *.example.com（totp 不需要）")
    p_add.add_argument("--header-name", dest="header_name",
                       help="header 类型要注入的请求头名")
    p_add.add_argument("--param-name", dest="param_name",
                       help="query 类型要拼的查询参数名")
    p_add.add_argument("--force", action="store_true", help="覆盖已存在的凭据")
    p_add.add_argument("--lease-days", type=int, default=V.LEASE_DEFAULT_DAYS,
                       help=f"租约天数：到期后拒绝使用，必须先轮换（默认 {V.LEASE_DEFAULT_DAYS}，0=不设租约）")
    p_add.set_defaults(func=cmd_add)

    p_list = sub.add_parser("list", help="列出凭据（只显示名字/类型/域名）")
    p_list.set_defaults(func=cmd_list)

    p_rm = sub.add_parser("rm", help="删除凭据")
    p_rm.add_argument("name")
    p_rm.set_defaults(func=cmd_rm)

    p_test = sub.add_parser("test", help="走代理测一次")
    p_test.add_argument("name")
    p_test.add_argument("host")
    p_test.add_argument("path")
    p_test.set_defaults(func=cmd_test)

    p_panic = sub.add_parser("panic", help="一键吊销：停代理 + 禁用服务 + 隔离所有凭据密文")
    p_panic.add_argument("--dry-run", dest="dry_run", action="store_true",
                         help="只看会做什么，不真删")
    p_panic.set_defaults(func=cmd_panic)

    p_restore = sub.add_parser("restore", help="一条命令恢复：挪回密文 + 启用服务 + 验证")
    p_restore.add_argument("stamp", nargs="?", default=None,
                           help="指定要恢复的时间戳（默认恢复最新的）")
    p_restore.add_argument("--list", action="store_true", dest="list",
                           help="列出所有可恢复的隔离目录")
    p_restore.set_defaults(func=cmd_restore)

    p_revoke = sub.add_parser("revoke", help="吊销凭据（单个不拦；批量需审批）")
    p_revoke.add_argument("name", nargs="?", help="要吊销的凭据名")
    p_revoke.add_argument("names", nargs="*", help="（批量）多个凭据名")
    p_revoke.add_argument("--all", action="store_true", help="吊销全部凭据（需审批）")
    p_revoke.add_argument("--approval-id", dest="approval_id",
                          help="vault-guard 批准后的 id")
    p_revoke.set_defaults(func=cmd_revoke)

    p_rl = sub.add_parser("revoke-list", help="生成待吊销清单：哪些 token/会话在平台上还没停")
    p_rl.add_argument("--out", help="输出路径，默认 <vault>/REVOKE.md")
    p_rl.set_defaults(func=cmd_revoke_list)

    p_ls = sub.add_parser("lease", help="给已有凭据设/改租约（不换值）")
    p_ls.add_argument("name")
    p_ls.add_argument("--days", type=int, help="租约天数，0=取消租约")
    p_ls.add_argument("--reset", action="store_true", help="从今天重新计时")
    p_ls.set_defaults(func=cmd_lease)

    p_mint = sub.add_parser("mint", help="用 GitHub App 签发短时令牌（1 小时，自动过期）")
    p_mint.add_argument("name")
    p_mint.add_argument("--app-id", required=True)
    p_mint.add_argument("--installation", required=True)
    p_mint.add_argument("--key", required=True, help="App 私钥 .pem 路径")
    p_mint.add_argument("--domains", default="api.github.com")
    p_mint.set_defaults(func=cmd_mint)

    p_rot = sub.add_parser("rotate", help="轮换凭据值（身份/白名单不变，租约重新计时）")
    p_rot.add_argument("name")
    p_rot.add_argument("--lease-days", type=int, help="顺便改租约天数")
    p_rot.add_argument("--force", action="store_true", help="totp 换种子要显式确认（等于换 2FA）")
    p_rot.set_defaults(func=cmd_rotate)

    p_verify = sub.add_parser("audit-verify", help="校验审计日志哈希链完整性（可对机外锚）")
    p_verify.add_argument("--anchor", help="机外锚文件；给了就只比锚，不看整条链")
    p_verify.add_argument("--file", help="指定审计文件（默认 ~/.deepseekbot/vault/audit.log）")
    p_verify.set_defaults(func=cmd_audit_verify)

    # ── 主密码 / 自动锁定 ──
    p_adopt = sub.add_parser("adopt", help="把老格式裸密文登记进索引（只补元数据，不重新加密）")
    p_adopt.add_argument("--dry-run", dest="dry_run", action="store_true", help="只看会做什么")
    p_adopt.set_defaults(func=cmd_adopt)

    p_scope = sub.add_parser("scope", help="给凭据收紧 HTTP 作用域（方法 + 路径前缀）")
    p_scope.add_argument("name")
    p_scope.add_argument("--methods", default=None,
                         help="允许的方法，逗号分隔，如 GET,POST；给空串表示清空")
    p_scope.add_argument("--paths", default=None,
                         help="允许的路径前缀，逗号分隔，如 /repos/,/user")
    p_scope.set_defaults(func=cmd_scope)

    p_anchor = sub.add_parser("audit-anchor", help="导出审计链头到机外可核对的锚文件")
    p_anchor.add_argument("--out", help="锚文件路径（默认 vault/audit-anchor.json）")
    p_anchor.add_argument("--check", help="改为核对已有锚文件")
    p_anchor.set_defaults(func=cmd_anchor)

    p_init = sub.add_parser("init", help="设置主密码（首次）")
    p_init.add_argument("--timeout", type=int, default=None,
                        help="自动锁定超时分钟数（默认 30）")
    p_init.set_defaults(func=cmd_init)

    p_unlock = sub.add_parser("unlock", help="解锁保险库")
    p_unlock.add_argument("--timeout", type=int, default=None,
                          help="本次解锁有效期（分钟）")
    p_unlock.set_defaults(func=cmd_unlock)

    p_lock = sub.add_parser("lock", help="立即锁定")
    p_lock.set_defaults(func=cmd_lock)

    p_status = sub.add_parser("status", help="查看解锁状态与剩余时间")
    p_status.set_defaults(func=cmd_status)

    p_passwd = sub.add_parser("passwd", help="修改主密码")
    p_passwd.set_defaults(func=cmd_passwd)

    p_timeout = sub.add_parser("timeout", help="查看/设置自动锁定超时")
    p_timeout.add_argument("minutes", nargs="?", type=int, default=None)
    p_timeout.set_defaults(func=cmd_timeout)

    # ── 恢复码 ──
    p_rc = sub.add_parser("recovery-codes", help="生成紧急恢复码")
    p_rc.add_argument("--count", type=int, default=None, help="生成几个（默认 10）")
    p_rc.add_argument("--force", action="store_true", help="覆盖已有恢复码")
    p_rc.set_defaults(func=cmd_recovery_codes)

    p_rr = sub.add_parser("recovery-reset", help="用恢复码重置主密码")
    p_rr.set_defaults(func=cmd_recovery_reset)

    # ── 安全审计 ──
    p_ar = sub.add_parser("audit-report", help="安全审计报告（Watchtower 式）")
    p_ar.set_defaults(func=cmd_audit_report)

    args = ap.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
