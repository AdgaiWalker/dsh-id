#!/usr/bin/env python3
"""dsh-id — 账号凭据与登录态的统一入口。

只是名字和入口，底层一个都不重写：
  dsh-id creds    凭据：增删查测、panic/restore、审计校验     → dsh-id creds
  dsh-id session  网页会话：存 / 用 / 查 / 删                  → dsh-id session
  dsh-id exec     按需注入凭据发一次请求（明文不进日志/argv）  → dsh-id exec
  dsh-id guard    不可逆操作审批：check / pending / approve    → dsh-id guard

不带参数时打印一屏状态，纯只读，不输出任何凭据值。
"""
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import urllib.request

BIN = os.path.expanduser("~/.local/bin")
LIBDIR = os.path.expanduser("~/.local/lib/dsh-id")
PY = sys.executable or "python3"
# 内部实现都在 ~/.local/lib/dsh-id；PATH 上只有 dsh-id / dsh-id-panel 和 3 个 shim
TARGETS = {
    "creds": (PY, os.path.join(LIBDIR, "creds.py")),
    "vault": (PY, os.path.join(LIBDIR, "creds.py"), "--vault"),
    "session": (PY, os.path.join(LIBDIR, "session.py")),
    "exec": (PY, os.path.join(LIBDIR, "exec.py")),
    "guard": (PY, os.path.join(LIBDIR, "guard.py")),
    "login": (PY, os.path.join(LIBDIR, "login.py")),
    "panel": (os.path.join(BIN, "dsh-id-panel"),),
}
ALIASES = {"cred": "creds", "credo": "creds", "sessions": "session", "sess": "session"}


def run(cmd, *args):
    exe = os.path.join(BIN, cmd)
    if not os.access(exe, os.X_OK):
        return None
    try:
        r = subprocess.run([exe, *args], capture_output=True, text=True, timeout=30)
        return r.stdout + r.stderr
    except Exception as exc:  # 读不到就说读不到，不装成空
        return f"[读取失败: {exc}]"


def count_rows(text):
    """表格行数：跳过表头、分隔线、小标题、空行。"""
    if not text:
        return 0
    n = 0
    for line in text.splitlines():
        s = line.strip()
        if not s or s.startswith(("名字", "---", "===", "（", "[")):
            continue
        if re.match(r"^-{3,}", s):
            continue
        n += 1
    return n


def status():
    st = run("dsh-id", "vault", "status") or ""
    creds = run("dsh-id", "creds", "list") or ""
    sess = run("dsh-id", "session", "list") or ""
    pend = run("dsh-id", "guard", "pending") or ""
    audit = run("dsh-id", "creds", "audit", "verify") or ""

    def pick(pattern, default="?"):
        m = re.search(pattern, st)
        return m.group(1).strip() if m else default

    unlock = pick(r"解锁方式:\s*(.+)")
    master = pick(r"主密码态:\s*(.+)")
    n_cred = count_rows(creds)
    n_sess = count_rows(sess)

    expiries = re.findall(r"(\d{4}-\d{2}-\d{2}) \d{2}:\d{2}:\d{2}\s+有效期内", sess)
    soon = min(expiries) if expiries else "无"

    if "哈希链完整" in audit:
        chain = "✓ 完整"
    elif "旧格式" in audit:
        chain = "✓ 完整（含旧格式行）"
    elif "[" in audit or "失败" in audit:
        chain = "✗ " + audit.strip().splitlines()[-1][:60]
    else:
        chain = "? 未校验"

    n_pend = 0 if "没有待批准" in pend else count_rows(pend)

    lines = [
        "════ dsh-id ════",
        f"  解锁       {unlock}",
        f"  主密码     {master}",
        f"  凭据       {n_cred} 个      dsh-id creds list",
        f"  会话       {n_sess} 个      最近过期 {soon}",
        f"  审计链     {chain}",
        f"  待审批     {n_pend} 件" + ("      dsh-id guard pending" if n_pend else ""),
        "",
        "  creds   凭据增删查测 / panic / restore / 审计校验",
        "  session 网页会话 存·用·查·删",
        "  exec    按需注入凭据发一次请求",
        "  guard   不可逆操作审批",
        "  panel   本机面板（127.0.0.1:8791）",
        "  login   自动登录并保存会话",

        "  doctor  自检并生成可粘贴的诊断报告",

    ]
    print("\n".join(lines))


REPO = "AdgaiWalker/dsh-id"
RELEASES = f"https://api.github.com/repos/{REPO}/releases/latest"


def _vaultlib():
    sys.path.insert(0, os.path.expanduser("~/.local/lib"))
    import vaultlib
    return vaultlib


def _latest_release(timeout=6):
    """读 GitHub 最新 release；断网/超时返回 None（不猜）。"""
    try:
        req = urllib.request.Request(RELEASES, headers={
            "User-Agent": "dsh-id", "Accept": "application/vnd.github+json"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.load(r).get("tag_name", "").lstrip("v")
    except Exception:
        return None


def _cmp_ver(a, b):
    def parts(v):
        return [int(x) for x in re.findall(r"\d+", v or "")] or [0]
    pa, pb = parts(a), parts(b)
    n = max(len(pa), len(pb))
    pa += [0] * (n - len(pa)); pb += [0] * (n - len(pb))
    return (pa > pb) - (pa < pb)


def collect_checks(check_update=False):
    V = _vaultlib()
    out = []

    def add(name, ok, detail, hint=""):
        out.append({"name": name, "ok": ok, "detail": detail, "hint": hint})

    py = ".".join(str(x) for x in sys.version_info[:3])
    add("Python", sys.version_info[:2] >= (3, 10), py, "需要 3.10+")
    ossl = shutil.which("openssl")
    add("openssl", bool(ossl), ossl or "未找到", "装 openssl")

    vd = V._vault_dir()
    exists = os.path.isdir(vd)
    mode = oct(os.stat(vd).st_mode & 0o777) if exists else "-"
    add("数据目录", exists and mode == "0o700", f"{vd} ({mode})", "应为 700")
    key = os.path.join(vd, "vault.key")
    kh = os.path.exists(key)
    kmode = oct(os.stat(key).st_mode & 0o777) if kh else "-"
    add("密钥文件", kh and kmode == "0o600", f"{'存在' if kh else '缺失'} ({kmode})", "应为 600")

    creds = V.list_credentials()
    exp = [c["name"] for c in creds if V.lease_state(c)[0] == "expired"]
    add("凭据", not exp, f"{len(creds)} 个" + (f"，已过期 {', '.join(exp)}" if exp else ""),
        "dsh-id creds rotate <名字>")

    sess = V.list_sessions()
    okc, probs, total, legacy = V.verify_chain()
    add("审计链", okc is True, {"ok": f"完整（{total} 行）", "unknown": "无法校验",
                                "bad": f"{len(probs)} 处异常"}[
        "ok" if okc else ("unknown" if okc is None else "bad")],
        "dsh-id creds audit verify")

    # 账实一致（v0.2.0）：vault 里有、索引里没有 = 面板看不见的秘密
    legacy_pending = [x["name"] for x in V.legacy_files() if not V.meta_exists(x["name"])]
    add("账实一致", not legacy_pending,
        f"索引 {len(creds)} 个，另有 {len(legacy_pending)} 个未入索引"
        + (f"（{', '.join(legacy_pending[:4])}）" if legacy_pending else ""),
        "dsh-id creds adopt")

    totps = [c["name"] for c in creds if c.get("type") in V.NO_EXEC_TYPES]
    add("第二因素", True, f"{len(totps)} 个种子" + (f"（{', '.join(totps)}）" if totps else ""),
        "dsh-id creds add <名字> totp")

    unscoped = [c["name"] for c in creds
                if c.get("type") not in V.NO_EXEC_TYPES
                and not V.scope_of(c)["methods"] and not V.scope_of(c)["paths"]]
    add("作用域", not unscoped,
        f"{len(unscoped)} 个凭据未收紧" + (f"（{', '.join(unscoped[:4])}）" if unscoped else ""),
        "dsh-id creds scope <名字> --methods GET,POST --paths /repos/")

    anchor_path = os.path.join(vd, "audit-anchor.json")
    if not os.path.exists(anchor_path):
        anchor_path = os.path.expanduser("~/.dsh/log/dsh-id-audit-anchor.json")
    if not os.path.exists(anchor_path):
        add("机外锚", None, "还没导出过", "dsh-id creds audit-anchor --out <机外路径>")
    else:
        st, detail = V.verify_anchor(anchor_path)
        add("机外锚", st == "ok", detail, "若 rewritten/truncated：日志不可信")

    pend = 0
    try:
        with open(os.path.join(vd, "guard-pending.json"), encoding="utf-8") as fh:
            pend = len((json.load(fh) or {}).get("pending", []))
    except Exception:
        pass
    add("待审批", pend == 0, f"{pend} 件", "dsh-id guard pending")

    errs = [r for r in V.recent_logs(200)
            if any(k in str(r.get("action", "")) for k in ("fail", "expired", "error"))]
    add("最近错误", not errs, f"{len(errs)} 条" if errs else "无",
        "dsh-id doctor --json 附在 issue 里")

    if check_update:
        latest = _latest_release()
        if latest is None:
            add("版本更新", None, f"当前 {V.VERSION}，检查失败（离线？）", "")
        else:
            newest = _cmp_ver(V.VERSION, latest) >= 0
            add("版本更新", newest, f"当前 {V.VERSION}，最新 {latest}", "git pull 或用 release")
    return out


def doctor(args):
    V = _vaultlib()
    checks = collect_checks(getattr(args, "check_update", False))
    if getattr(args, "json", False):
        print(json.dumps({"version": V.VERSION, "os": platform.platform(),
                          "python": sys.version.split()[0], "checks": checks},
                         ensure_ascii=False, indent=2))
        return 0
    icon = {True: "✓", False: "✗", None: "?"}
    bad = [c for c in checks if c["ok"] is False]
    print(f"dsh-id {V.VERSION} · {platform.system()} · Python {sys.version.split()[0]}")
    for c in checks:
        line = f"  {icon[c['ok']]} {c['name']:<8} {c['detail']}"
        if c["ok"] is False and c["hint"]:
            line += f"   → {c['hint']}"
        print(line)
    print()
    if bad:
        print(f"{len(bad)} 项需要处理：" + "、".join(c["name"] for c in bad))
        print("把 `dsh-id doctor --json` 的输出贴到 issue 里（不含任何凭据值）")
    else:
        print("全部正常。")
    print(f"报告: dsh-id doctor --json   ·  反馈: https://github.com/{REPO}/issues/new/choose")
    return 1 if bad else 0


def main():
    argv = sys.argv[1:]
    if argv and argv[0] in ("doctor", "check"):
        class A:
            json = "--json" in argv
            check_update = "--check-update" in argv or "--update" in argv
        return doctor(A)
    if argv and argv[0] in ("version", "-V", "--version"):
        return print(_vaultlib().VERSION)
    if not argv or argv[0] in ("-h", "--help", "help", "status"):
        return status()
    cmd = ALIASES.get(argv[0], argv[0])
    if cmd not in TARGETS:
        print(f"dsh-id: 不认识 '{argv[0]}'，可用的是 "
              f"{' / '.join(TARGETS)}（或直接不带参数看状态）", file=sys.stderr)
        return 2
    parts = TARGETS[cmd]
    exe, args = parts[0], list(parts[1:])
    if not os.access(exe, os.R_OK):
        print(f"dsh-id: 找不到 {exe}", file=sys.stderr)
        return 2
    if exe.endswith(".py"):
        os.execv(exe, [exe, *args, *argv[1:]])
    os.execv(exe, [exe, *args, *argv[1:]])


if __name__ == "__main__":
    sys.exit(main())
