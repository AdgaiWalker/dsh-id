{
  "name": "dsh-account-vault",
  "version": "0.3.0",
  "description": "DSH 插件：账号与凭据元数据只读查询 + 执行能力（带凭据发请求、会话开浏览器、浏览器操作）。不返回凭据值。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node test/offline.mjs && node test/exec.mjs",
    "test:readonly": "node test/offline.mjs",
    "test:exec": "node test/exec.mjs",
    "prepare:test-deps": "node scripts/link-test-deps.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}